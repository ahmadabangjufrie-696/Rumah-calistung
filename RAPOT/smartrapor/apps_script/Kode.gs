  // Panel SmartRapor
  MAPEL_SEKOLAH: ["PAI", "PKN", "B. INDO", "MTK", "IPA", "IPS", "B. INGGRIS", "SENI BUDAYA", "PJOK", "INFORMATIKA", "PRAKARYA", "MULOK"],      // tab mapel umum, nilai raport di kolom Q
