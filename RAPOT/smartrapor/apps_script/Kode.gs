  BERANDA: 'BERANDA',
  SISWA: 'SISWA',
  PILIH: 'I25',                 // kotak pilihan "No - Nama" di BERANDA
  CENTANG: 'H31:H34',           // kotak centang "Yang dicetak" di BERANDA
