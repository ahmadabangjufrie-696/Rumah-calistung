\n.t3{background:#fff;color:var(--h);border:2px solid var(--h)}.t3 .i{background:var(--muda)}\n.cb{font-size:13px;font-weight:600;padding:7px 11px;border-radius:10px;border:1.5px solid #ddd3b8;color:#777;background:#fff}\n.cb.on{background:var(--muda);border-color:var(--h);color:var(--h)}\n.paper{background:#fff;border-radius:8px;box-shadow:0 14px 34px rgba(0,0,0,.16),0 0 0 1px #eee;padding:8px;position:relative;cursor:zoom-in;min-height:420px;display:flex;justify-content:center;align-items:flex-start}\n.paper canvas{width:100%;height:auto}\n.paper .ly{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:rgba(255,255,255,.88);font-size:12.5px;color:var(--abu);font-weight:600;text-align:center;padding:20px}\n.tabs{display:flex;gap:5px;margin-bottom:10px;flex-wrap:wrap}\n/* ------------------------------------------------ lapisan */\n.simpan{position:fixed;left:50%;transform:translateX(-50%);bottom:22px;z-index:7;background:#1f2a24;color:#fff;border-radius:16px;padding:10px 10px 10px 18px;display:flex;align-items:center;gap:14px;box-shadow:0 18px 40px rgba(0,0,0,.35);font-weight:600;font-size:13.5px;max-width:calc(100% - 24px)}\n.simpan .tb{padding:10px 18px}\n.lapis{position:fixed;inset:0;background:rgba(15,30,22,.6);display:none;align-items:center;justify-content:center;z-index:20;padding:16px}\n.lapis.buka{display:flex}\n.kartu{background:#fff;border-radius:18px;padding:24px 24px 20px;width:100%;max-width:460px;box-shadow:0 24px 60px rgba(0,0,0,.35);max-height:calc(100vh - 32px);overflow:auto}\n.kartu h3{font-family:'Playfair Display',serif;font-size:23px;color:var(--h);margin-bottom:8px}\n.kartu p{font-size:13.5px;color:#555;margin-bottom:14px;line-height:1.55}\n.kartu .aksi{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:14px}\n.barp{height:10px;background:#eef3ef;border-radius:6px;overflow:hidden;margin:6px 0 14px}\n.barp i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--h),var(--e));transition:width .4s}\n.besar{position:fixed;inset:0;background:rgba(20,24,22,.88);display:none;z-index:15;overflow:auto;padding:24px 12px;text-align:center}\n.besar.buka{display:block}\n.besar canvas{display:block;margin:0 auto 18px;box-shadow:0 10px 30px rgba(0,0,0,.5);max-width:100%;background:#fff}\n.tutup{position:fixed;top:12px;right:16px;color:#fff;font-size:30px;z-index:16}\n.toast{position:fixed;top:84px;left:50%;transform:translateX(-50%) translateY(-20px);opacity:0;background:var(--h);color:#fff;padding:11px 20px;border-radius:12px;font-weight:600;z-index:25;transition:.25s;pointer-events:none;box-shadow:0 10px 26px rgba(0,0,0,.25);max-width:calc(100% - 32px);text-align:center}\n.toast.buka{opacity:1;transform:translateX(-50%) translateY(0)}\n.toast.gagal{background:var(--merah)}\n.lain{position:fixed;inset:0;background:rgba(15,30,22,.5);z-index:12;display:none;align-items:flex-end}\n.lain.buka{display:flex}\n.lain .lk{background:#fff;width:100%;border-radius:20px 20px 0 0;padding:14px 14px calc(20px + env(safe-area-inset-bottom))}\n.cek{display:flex;flex-wrap:wrap;gap:6px}\n.cek label{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;border:1.5px solid #e4dcc3;border-radius:10px;padding:6px 9px;cursor:pointer;background:#fff}\n.cek input{accent-color:var(--h)}\n.fl .cek label{text-transform:none;letter-spacing:0;color:#333;font-size:12.5px;margin:0}\n.ctk .grid4{grid-template-columns:repeat(2,1fr)}\n.ctk .row3{grid-template-columns:1fr}\n.akl{display:flex;align-items:center;gap:12px;padding:12px 4px;border-bottom:1px dashed #eee6d2}\n.akl .av{width:40px;height:40px;border-radius:50%;background:var(--muda);color:var(--h);display:flex;align-items:center;justify-content:center;font-weight:700;flex:none}\n.akl .nm{flex:1;min-width:0}\n.akl .nm b{display:block}\n.akl .nm small{color:#888;font-size:12px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.wali{background:#f7f0dc;color:#7a5c12;font-size:10.5px;font-weight:700;border-radius:8px;padding:2px 8px;margin-left:6px}\n/* ------------------------------------------------ HP */\n@media (max-width:1100px){.ctk{grid-template-columns:260px 1fr}.ctk .kn{grid-column:1/-1;max-width:520px}.grid4{grid-template-columns:repeat(2,1fr)}}\n@media (max-width:820px){\n  .nav{display:none}\n  .navhp{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:10;background:#fff;border-top:1px solid var(--garis);padding:6px 4px calc(6px + env(safe-area-inset-bottom));box-shadow:0 -6px 20px rgba(0,0,0,.06)}\n  .navhp button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10.5px;font-weight:600;color:#7a827d;padding:4px 0}\n  .navhp button .i{font-size:19px;width:44px;height:28px;border-radius:14px;display:flex;align-items:center;justify-content:center}\n  .navhp button.on{color:var(--h)}\n  .navhp button.on .i{background:var(--muda)}\n  .simpan{bottom:calc(76px + env(safe-area-inset-bottom));font-size:12.5px;white-space:nowrap}\n  .app.link~.simpan{bottom:calc(16px + env(safe-area-inset-bottom))}\n  main{padding:16px 14px 150px}\n  .hd{height:60px;padding:0 12px}\n  .hd img{width:36px;height:36px}\n  .brand .t{font-size:20px}\n  .chips{display:none}\n  .akunb{margin-left:auto}\n  .akunb .nmu{display:none}\n  .toast{top:70px}\n  .jd{font-size:25px}\n  .grid4{grid-template-columns:repeat(2,1fr);gap:10px}\n  .c .v{font-size:25px}\n  .pb{width:96px}\n  .mp .aksi .tb{padding:7px 10px}\n  .dua,.ctk{grid-template-columns:minmax(0,1fr)}\n  .hdr .nmb{font-size:22px;min-width:0;flex-basis:100%}\n  .daftar{position:static;max-height:260px}\n  .f{grid-template-columns:1fr}\n  .tpg{grid-template-columns:1fr 1fr}\n  .bungkus{max-height:none}\n  .tn .nm{min-width:128px;max-width:140px;padding:4px 6px;font-size:12px}\n  .ab{grid-template-columns:1fr;gap:6px}\n  .pbm{grid-template-columns:1fr}\n  .row3{grid-template-columns:1fr}\n  .hadir3{grid-template-columns:1fr;gap:8px}\n  .hadir3 .c{display:flex;align-items:center;justify-content:space-between;padding:8px 12px}\n  .hadir3 .stp{margin:0}\n  .f>*{min-width:0}\n}\n</style></head>\n<body>\n\n<!-- ============================================== MASUK -->\n<div class=\"masuk\" id=\"layarMasuk\">\n  <div class=\"mk\">\n    <img src=\"data:image/png;base64,\" alt=\"\">\n    <div class=\"t\">Smart<b>Rapor</b></div>\n    <div class=\"u\">Raport Kurikulum Merdeka</div>\n    <div class=\"sk\" id=\"mkSekolah\">&nbsp;</div>\n    <div id=\"mkIsi\"><div class=\"muat\" style=\"justify-content:center\"><div class=\"putar\"></div>Memuat…</div></div>\n  </div>\n</div>\n\n<!-- ============================================== APLIKASI -->\n<div class=\"app\" id=\"layarApp\" hidden>\n  <header class=\"hd\">\n    <img src=\"data:image/png;base64,\" alt=\"\">\n    <div class=\"brand\"><div class=\"t\">Smart<b>Rapor</b></div><div class=\"u\" id=\"hdSekolah\"></div></div>\n    <div class=\"chips\" id=\"chips\"></div>\n    <button class=\"akunb\" onclick=\"menuAkun()\"><span class=\"av\" id=\"avSaya\"></span><span class=\"nmu\" id=\"nmSaya\"></span></button>\n  </header>\n  <div class=\"bd\">\n    <nav class=\"nav\" id=\"nav\"></nav>\n    <main id=\"isi\"></main>\n  </div>\n  <nav class=\"navhp\" id=\"navhp\"></nav>\n</div>\n\n<div class=\"simpan\" id=\"barSimpan\" hidden><span id=\"barTeks\">Ada perubahan belum disimpan</span>\n  <button class=\"tb tbe\" id=\"tbSimpan\" onclick=\"simpanSekarang()\">💾 Simpan</button></div>\n<div class=\"lapis\" id=\"lapis\"><div class=\"kartu\" id=\"kartu\"></div></div>\n<div class=\"lain\" id=\"lain\" onclick=\"if(event.target===this)tutupLain()\"><div class=\"lk\" id=\"lainIsi\"></div></div>\n<div class=\"besar\" id=\"besar\"><button class=\"tutup\" onclick=\"tutupBesar()\">✕</button><div id=\"besarIsi\"></div></div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n<script>\n// =================================================================== dasar\nvar KODE_GURU = '__KODE__'; if (KODE_GURU.indexOf('__') === 0) KODE_GURU = '';\nvar TOKEN = null, SAYA = null, DEPAN = null, HAL = null, KOTOR = null, CACHE = {};\nvar NAMA_JENIS = { sekolah: 'Raport Sekolah', pondok: 'Raport Pondok', p5: 'Raport P5', cover: 'Cover',\n                   identitas: 'Identitas Sekolah', diri: 'Keterangan Diri' };\nfunction $(id) { return document.getElementById(id); }\nfunction aman(t) { return String(t == null ? '' : t).replace(/[&<>\"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]; }); }\nfunction angka(x, d) { return x === '' || x == null || isNaN(x) ? '–' : Number(x).toFixed(d).replace('.', ','); }\nfunction inisial(n) { return String(n || '?').trim().split(/\\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join('').toUpperCase(); }\nfunction simpanLokal(k, v) { try { if (v == null) sessionStorage.removeItem(k); else sessionStorage.setItem(k, v); } catch (e) {} }\nfunction ambilLokal(k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } }\nfunction ingat(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }\nfunction ingatan(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }\n\nfunction panggil(fn) {\n  var args = Array.prototype.slice.call(arguments, 1);\n  return new Promise(function (ok, gagal) {\n    var r = google.script.run.withSuccessHandler(ok).withFailureHandler(function (e) {\n      var m = (e && e.message) || String(e);\n      if (m.indexOf('SESI_HABIS') >= 0) { sesiHabis(); gagal(new Error('Sesi masuk sudah habis. Silakan masuk lagi.')); return; }\n      gagal(new Error(m.replace(/^Error:\\s*/, '')));\n    });\n    r[fn].apply(r, args);\n  });\n}\nfunction api(fn) { return panggil.apply(null, [fn, TOKEN].concat(Array.prototype.slice.call(arguments, 1))); }\n\nfunction toast(t, gagal) {\n  var e = $('toast'); e.textContent = t; e.className = 'toast buka' + (gagal ? ' gagal' : '');\n  clearTimeout(toast.w); toast.w = setTimeout(function () { e.className = 'toast'; }, gagal ? 5000 : 2600);\n}\nfunction kartu(html) { $('kartu').style.maxWidth = ''; $('kartu').innerHTML = html; $('lapis').classList.add('buka'); }\nfunction tutupKartu() { $('lapis').classList.remove('buka'); }\nfunction memuat(t) { return '<div class=\"muat\"><div class=\"putar\"></div>' + aman(t || 'Memuat…') + '</div>'; }\nfunction galatHal(e) { $('isi').innerHTML = '<div class=\"kosong\" style=\"color:#c0392b\">Gagal: ' + aman(e.message) + '<br><br><button class=\"tb tbg\" onclick=\"buka(HAL.id, HAL.arg)\">Coba lagi</button></div>'; }\n\n// =================================================================== masuk\nfunction mulai() {\n  panggil('webDepan').then(function (d) {\n    DEPAN = d;\n    $('mkSekolah').textContent = [d.sekolah, d.kelas && 'Kelas ' + d.kelas].filter(Boolean).join(' · ') || ' ';\n    if (KODE_GURU) {                       // link khusus guru mapel: tanpa PIN\n      return panggil('webGuruMasuk', KODE_GURU).then(function (h) { TOKEN = h.token; masukBerhasil(h.saya); })\n        .catch(function (e) { $('mkIsi').innerHTML = '<p class=\"salah\" style=\"font-size:14.5px;line-height:1.6\">' + aman(e.message) + '</p>'; });\n    }\n    var t = ambilLokal('sr_token');\n    if (t) {\n      TOKEN = t;\n      return panggil('webSaya', t).then(masukBerhasil).catch(function () { TOKEN = null; simpanLokal('sr_token', null); formMasuk(); });\n    }\n    formMasuk();\n  }).catch(function (e) { $('mkIsi').innerHTML = '<p class=\"salah\">Gagal memuat: ' + aman(e.message) + '</p>'; });\n}\n\nfunction formMasuk(pesan) {\n  $('layarApp').hidden = true; $('layarMasuk').hidden = false;\n  if (!DEPAN.akun.length) {\n    $('mkIsi').innerHTML = '<p class=\"sjd\" style=\"margin:6px 0 0\">Aplikasi belum disiapkan.<br>Wali kelas: buka file Google Sheet, lalu menu <b>SmartRapor › Aplikasi web: buat / ganti PIN wali kelas</b>.</p>';\n    return;\n  }\n  var terakhir = ingatan('sr_akun');\n  $('mkIsi').innerHTML =\n    '<div class=\"fl\"><label>Nama</label><select class=\"in\" id=\"mNama\">' +\n    DEPAN.akun.map(function (a) { return '<option value=\"' + aman(a.id) + '\"' + (a.id === terakhir ? ' selected' : '') + '>' + aman(a.nama) + (a.peran === 'wali' ? ' (wali kelas)' : '') + '</option>'; }).join('') +\n    '</select></div><div class=\"fl\"><label>PIN</label><input class=\"in pin\" id=\"mPin\" type=\"password\" inputmode=\"numeric\" maxlength=\"8\" autocomplete=\"current-password\" placeholder=\"••••\"></div>' +\n    '<button class=\"tb1\" id=\"mTb\" onclick=\"masuk()\">Masuk</button><div class=\"salah\" id=\"mSalah\">' + aman(pesan || '') + '</div>' +\n    '<div class=\"kecil\">Lupa PIN? Minta wali kelas mengganti PIN di halaman Akun Guru.</div>';\n  $('mPin').onkeydown = function (e) { if (e.key === 'Enter') masuk(); };\n  setTimeout(function () { $('mPin').focus(); }, 50);\n}\n\nfunction masuk() {\n  var id = $('mNama').value, pin = $('mPin').value;\n  if (!pin) { $('mSalah').textContent = 'Isi PIN dulu.'; return; }\n  $('mTb').disabled = true; $('mTb').textContent = 'Memeriksa…'; $('mSalah').textContent = '';\n  panggil('webMasuk', id, pin).then(function (h) {\n    ingat('sr_akun', id); TOKEN = h.token; simpanLokal('sr_token', h.token); masukBerhasil(h.saya);\n  }).catch(function (e) {\n    $('mTb').disabled = false; $('mTb').textContent = 'Masuk'; $('mSalah').textContent = e.message; $('mPin').value = ''; $('mPin').focus();\n  });\n}\n\nfunction sesiHabis() {\n  if (KODE_GURU) { TOKEN = null; panggil('webGuruMasuk', KODE_GURU).then(function (h) { TOKEN = h.token; toast('Sambungan diperbarui. Silakan tekan Simpan lagi.'); }).catch(function (e) { toast(e.message, true); }); return; }\n  TOKEN = null; SAYA = null; simpanLokal('sr_token', null); KOTOR = null; $('barSimpan').hidden = true;\n  if (DEPAN) formMasuk('Sesi sudah habis. Silakan masuk lagi.');\n}\n\nfunction keluar() {\n  if (KOTOR && !confirm('Ada perubahan yang belum disimpan. Tetap keluar?')) return;\n  tutupLain(); panggil('webKeluar', TOKEN).catch(function () {});\n  TOKEN = null; SAYA = null; simpanLokal('sr_token', null); KOTOR = null; $('barSimpan').hidden = true; formMasuk();\n}\n\n// =================================================================== kerangka\nvar MENU = [\n  { id: 'beranda', i: '🏠', t: 'Beranda' },\n  { id: 'nilai', i: '📝', t: 'Input Nilai' },\n  { id: 'hadir', i: '📅', t: 'Kehadiran & Catatan', w: 1, p: 'Hadir' },\n  { id: 'cetak', i: '🖨️', t: 'Cetak Raport', w: 1, p: 'Cetak' },\n  { id: 'p5', i: '🌱', t: 'Projek P5', p5: 1, p: 'P5' },\n  { id: 'siswa', i: '👨‍🎓', t: 'Data Siswa', w: 1 },\n  { id: 'atur', i: '⚙️', t: 'Pengaturan', w: 1 },\n  { id: 'akun', i: '👥', t: 'Guru & Link WA', w: 1 }\n];\nfunction menuSaya() { return MENU.filter(function (m) { return (!m.w || SAYA.peran === 'wali') && (!m.p5 || SAYA.p5); }); }\n\nfunction masukBerhasil(saya) {\n  SAYA = saya;\n  $('layarMasuk').hidden = true; $('layarApp').hidden = false;\n  $('hdSekolah').textContent = DEPAN.sekolah || '';\n  $('chips').innerHTML = [DEPAN.kelas && 'Kelas ' + DEPAN.kelas, DEPAN.semester && 'Semester ' + DEPAN.semester, DEPAN.tahun]\n    .filter(Boolean).map(function (t) { return '<span class=\"chip\">' + aman(t) + '</span>'; }).join('');\n  $('avSaya').textContent = inisial(saya.nama); $('nmSaya').textContent = saya.nama;\n  var satu = saya.link && saya.mapel.length + (saya.p5 ? 1 : 0) <= 1;\n  $('layarApp').classList.toggle('link', satu);\n  if (satu) { buka(saya.p5n ? 'p5' : 'nilai', saya.p5n || saya.mapel[0]); return; }\n  var m = menuSaya();\n  $('nav').innerHTML = '<div class=\"lab\">Menu</div>' + m.map(function (x) {\n    return '<button class=\"ni\" data-id=\"' + x.id + '\" onclick=\"buka(\\'' + x.id + '\\')\"><span class=\"i\">' + x.i + '</span>' + x.t + '</button>';\n  }).join('');\n  var hp = m.slice(0, 4);\n  $('navhp').innerHTML = hp.map(function (x) {\n    return '<button data-id=\"' + x.id + '\" onclick=\"buka(\\'' + x.id + '\\')\"><span class=\"i\">' + x.i + '</span>' + (x.p || x.t.split(' ').slice(-1)[0]) + '</button>';\n  }).join('') + (m.length > 4 ? '<button data-id=\"_lain\" onclick=\"bukaLain()\"><span class=\"i\">☰</span>Lainnya</button>' : '');\n  buka('beranda');\n}\n\nfunction bukaLain() {\n  $('lainIsi').innerHTML = menuSaya().slice(4).map(function (x) {\n    return '<button class=\"ni\" onclick=\"tutupLain();buka(\\'' + x.id + '\\')\"><span class=\"i\">' + x.i + '</span>' + x.t + '</button>';\n  }).join('') + '<button class=\"ni\" onclick=\"tutupLain();gantiPin()\"><span class=\"i\">🔑</span>Ganti PIN saya</button>' +\n    '<button class=\"ni\" onclick=\"keluar()\"><span class=\"i\">🚪</span>Keluar</button>';\n  $('lain').classList.add('buka');\n}\nfunction tutupLain() { $('lain').classList.remove('buka'); }\nfunction menuAkun() {\n  if (SAYA.link) {\n    $('lainIsi').innerHTML = '<div style=\"padding:4px 10px 10px\"><b style=\"font-size:16px\">' + aman(SAYA.nama) + '</b><div style=\"color:#888;font-size:12.5px;margin-top:4px\">Masuk lewat link khusus dari wali kelas. Hanya untuk mengisi ' +\n      aman(SAYA.p5n ? 'P5 PROYEK ' + SAYA.p5n : SAYA.mapel.join(', ')) + '.</div></div><button class=\"ni\" onclick=\"tutupLain()\"><span class=\"i\">✕</span>Tutup</button>';\n    $('lain').classList.add('buka'); return;\n  }\n  $('lainIsi').innerHTML = '<div style=\"padding:4px 10px 10px\"><b style=\"font-size:16px\">' + aman(SAYA.nama) + '</b><div style=\"color:#888;font-size:12.5px\">' + (SAYA.peran === 'wali' ? 'Wali kelas' : 'Guru mapel') + '</div></div>' +\n    '<button class=\"ni\" onclick=\"tutupLain();gantiPin()\"><span class=\"i\">🔑</span>Ganti PIN saya</button>' +\n    '<button class=\"ni\" onclick=\"keluar()\"><span class=\"i\">🚪</span>Keluar</button>';\n  $('lain').classList.add('buka');\n}\n\nfunction buka(id, arg) {\n  if (KOTOR && !(HAL && HAL.id === id && HAL.arg === arg)) {\n    if (!confirm('Ada perubahan yang belum disimpan. Tinggalkan tanpa menyimpan?')) return;\n  }\n  setKotor(null);\n  HAL = { id: id, arg: arg };\n  document.querySelectorAll('.ni,.navhp button').forEach(function (b) { b.classList.toggle('on', b.dataset.id === id); });\n  window.scrollTo(0, 0);\n  ({ beranda: halBeranda, nilai: halNilai, hadir: halHadir, p5: halP5, cetak: halCetak, siswa: halSiswa, atur: halAtur, akun: halAkun }[id])(arg);\n}\n\n// tanda perubahan belum disimpan + tombol simpan melayang\nfunction setKotor(fnSimpan, teks) {\n  KOTOR = fnSimpan;\n  $('barSimpan').hidden = !fnSimpan;\n  if (fnSimpan) $('barTeks').textContent = teks || 'Ada perubahan belum disimpan';\n}\nfunction simpanSekarang() {\n  if (!KOTOR) return;\n  var tb = $('tbSimpan'); tb.disabled = true; tb.textContent = 'Menyimpan…';\n  Promise.resolve().then(KOTOR).then(function () { toast('Tersimpan ✓'); })\n    .catch(function (e) { toast('Gagal menyimpan: ' + e.message, true); })\n    .then(function () { tb.disabled = false; tb.textContent = '💾 Simpan'; });\n}\nwindow.addEventListener('beforeunload', function (e) { if (KOTOR) { e.preventDefault(); e.returnValue = ''; } });\n\nfunction judul(lab, jd, sub) {\n  return '<div class=\"lab\">' + aman(lab) + '</div><div class=\"jd\">' + jd + '</div>' + (sub ? '<div class=\"sjd\">' + sub + '</div>' : '');\n}\n\n// =================================================================== beranda\nfunction halBeranda() {\n  $('isi').innerHTML = judul('Beranda', 'Assalamu\\'alaikum, ' + aman(SAYA.nama.split(' ')[0] === SAYA.nama ? SAYA.nama : SAYA.nama), SAYA.peran === 'wali' ? 'Ringkasan kelas Ustadz/Ibu hari ini.' : 'Mapel yang Ustadz/Ibu pegang.') + memuat('Menghitung kemajuan nilai…');\n  api('webBeranda').then(function (d) {\n    var lengkap = d.mapel.filter(function (m) { return m.siswa && m.lengkap === m.siswa; }).length;\n    var nilaiAda = d.mapel.filter(function (m) { return m.rata !== ''; });\n    var rata = nilaiAda.length ? nilaiAda.reduce(function (t, m) { return t + m.rata; }, 0) / nilaiAda.length : '