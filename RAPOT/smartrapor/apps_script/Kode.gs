n)</option>' + P.perlu.map(function (p) { return '<option value=\"' + aman(p) + '\"' + (v === p ? ' selected' : '') + '>✗ Perlu bimbingan</option>'; }).join('') +\n        (lain ? '<option value=\"' + aman(v) + '\" selected>Kalimat lain (dari Sheet)</option>' : '') + '</select></div>';\n    }).join('') + '</div><div class=\"fl pn\"><label>Catatan wali kelas pondok</label><select class=\"in ar\" style=\"font-size:15px\" onchange=\"ubahEk(' + EKpilih + ',\\'cpondok\\',this.value)\">' +\n      '<option value=\"\">Otomatis menurut rata-rata nilai</option>' + P.catatanPondok.concat(s.cpondok && P.catatanPondok.indexOf(s.cpondok) < 0 ? [s.cpondok] : []).map(function (p) {\n        return '<option value=\"' + aman(p) + '\"' + (s.cpondok === p ? ' selected' : '') + '>' + aman(p) + '</option>';\n      }).join('') + '</select></div>';\n  }\n  h += '</div></div></div>' + datalist('dlKeg', P.kegiatan) + datalist('dlKet', P.ket) + datalist('dlKep', P.keputusan);\n  $('ekIsi').innerHTML = h;\n}\nfunction langkah(k, d) {\n  var inp = $('ek_' + k), x = Math.max(0, (parseInt(inp.value, 10) || 0) + d);\n  inp.value = x; ubahEk(EKpilih, k, String(x));\n}\n\n// =================================================================== P5\nvar P5 = null, P5ubah = {};\nfunction halP5(n) {\n  n = n || 1; HAL.arg = n;\n  $('isi').innerHTML = judul('Projek Penguatan Profil Pelajar Pancasila', 'Projek P5', SAYA.link ? 'Assalamu\\'alaikum, <b>' + aman(SAYA.nama) + '</b>. Silakan isi, lalu tekan tombol <b>💾 Simpan</b>.' : '') + '<div id=\"p5Isi\">' + memuat() + '</div>';\n  P5ubah = {};\n  api('webP5', n).then(function (d) { P5 = d; gambarP5(); }).catch(function (e) { $('p5Isi').innerHTML = '<div class=\"kosong\" style=\"color:#c0392b\">' + aman(e.message) + '</div>'; });\n}\nvar NILAI_P5 = ['', 'BB', 'MB', 'BSH', 'SB'];\nfunction gambarP5() {\n  var d = P5;\n  var h = '<div class=\"pil\" style=\"margin-bottom:14px\">' + d.proyek.map(function (p) {\n    return '<button class=\"pl' + (p.n === d.n ? ' on' : '') + '\" onclick=\"buka(\\'p5\\',' + p.n + ')\">Projek ' + p.n + (p.judul ? ' <small>· ' + aman(p.judul.slice(0, 28)) + '</small>' : '') + '</button>';\n  }).join('') + '</div>' +\n    '<details class=\"tp\"' + (d.judul ? '' : ' open') + '><summary>📘 Judul, deskripsi, dan aspek projek</summary><div style=\"padding:0 15px 15px\">' +\n    '<div class=\"f\"><div class=\"fl pn\"><label>Judul projek</label><input class=\"in\" id=\"p5Judul\" value=\"' + aman(d.judul) + '\" oninput=\"ubahP5()\"></div>' +\n    '<div class=\"fl pn\"><label>Deskripsi</label><textarea class=\"in\" id=\"p5Desk\" oninput=\"ubahP5()\">' + aman(d.desk) + '</textarea></div>' +\n    d.dimensi.map(function (x, k) {\n      return '<div class=\"gj\">Aspek ' + (k + 1) + '</div><div class=\"fl\"><label>Dimensi</label><input class=\"in\" data-dim=\"' + k + '\" value=\"' + aman(x) + '\" oninput=\"ubahP5()\"></div>' +\n        '<div class=\"fl\"><label>Sub-elemen – capaian</label><textarea class=\"in\" style=\"min-height:54px\" data-sub=\"' + k + '\" oninput=\"ubahP5()\">' + aman(d.sub[k]) + '</textarea></div>';\n    }).join('') + '</div></div></details>';\n  if (!d.siswa.length) { $('p5Isi').innerHTML = h + '<div class=\"blok\"><div class=\"kosong\">Data siswa masih kosong.</div></div>'; return; }\n  var aktif = d.dimensi.map(function (x, k) { return x || d.sub[k] ? k : -1; }).filter(function (k) { return k >= 0; });\n  if (!aktif.length) aktif = [0, 1, 2];\n  h += '<div class=\"bungkus\"><table class=\"tn\"><thead><tr><th class=\"nm\">Nama siswa</th>' + aktif.map(function (k) {\n    return '<th title=\"' + aman(d.sub[k]) + '\">Aspek ' + (k + 1) + '<small>' + aman(d.dimensi[k] || '') + '</small>' +\n      '<select style=\"margin-top:4px;width:70px;font-size:11px;padding:3px\" onchange=\"isiSemuaP5(' + k + ',this)\"><option value=\"\">isi semua…</option>' +\n      NILAI_P5.slice(1).map(function (v) { return '<option>' + v + '</option>'; }).join('') + '</select></th>';\n  }).join('') + '<th>Catatan proses</th></tr></thead><tbody>' + d.siswa.map(function (s) {\n    return '<tr><td class=\"nm\"><i>' + s.no + '</i>' + aman(s.nama) + '</td>' + aktif.map(function (k) {\n      return '<td><select data-no=\"' + s.no + '\" data-k=\"' + k + '\" data-awal=\"' + aman(s.isi[k]) + '\" onchange=\"ubahSelP5(this)\">' +\n        NILAI_P5.map(function (v) { return '<option' + (v === s.isi[k] ? ' selected' : '') + '>' + v + '</option>'; }).join('') + '</select></td>';\n    }).join('') + '<td class=\"ct\"><input data-no=\"' + s.no + '\" data-k=\"7\" data-awal=\"' + aman(s.catatan) + '\" value=\"' + aman(s.catatan) + '\" oninput=\"ubahSelP5(this)\"></td></tr>';\n  }).join('') + '</tbody></table></div><div class=\"ket\"><span>BB = Belum Berkembang · MB = Mulai Berkembang · BSH = Berkembang Sesuai Harapan · SB = Sangat Berkembang</span></div>';\n  $('p5Isi').innerHTML = h;\n}\nfunction ubahSelP5(el) {\n  el.classList.toggle('ubah', el.value !== el.dataset.awal);\n  P5ubah[el.dataset.no + '_' + el.dataset.k] = { no: +el.dataset.no, k: +el.dataset.k, v: el.value };\n  ubahP5();\n}\nfunction isiSemuaP5(k, sel) {\n  if (!sel.value) return;\n  document.querySelectorAll('#p5Isi select[data-k=\"' + k + '\"]').forEach(function (s) { s.value = sel.value; ubahSelP5(s); });\n  sel.value = '';\n}\nfunction ubahP5() { setKotor(simpanP5); }\nfunction simpanP5() {\n  var kirim = { ubah: Object.keys(P5ubah).map(function (k) { return P5ubah[k]; }) };\n  if ($('p5Judul')) {\n    kirim.judul = $('p5Judul').value; kirim.desk = $('p5Desk').value;\n    kirim.dimensi = P5.dimensi.map(function (x, k) { return document.querySelector('[data-dim=\"' + k + '\"]').value; });\n    kirim.sub = P5.sub.map(function (x, k) { return document.querySelector('[data-sub=\"' + k + '\"]').value; });\n  }\n  return api('webSimpanP5', P5.n, kirim).then(function (d) { P5 = d; P5ubah = {}; setKotor(null); gambarP5(); });\n}\n\n// =================================================================== data siswa\nvar SW = null, SWpilih = null, SWubah = {};\nvar GRUP_SISWA = [['Identitas', [1, 2, 3, 4, 5]], ['Kelahiran & keluarga', [6, 7, 8, 9, 10]], ['Alamat & sekolah asal', [11, 12, 13, 14, 15]],\n                  ['Orang tua', [16, 17, 18, 19, 20, 21, 22]], ['Wali', [23, 24, 25, 26]]];\nfunction halSiswa() {\n  $('isi').innerHTML = judul('Wali kelas', 'Data Siswa', 'Urutan siswa di sini dipakai di semua halaman raport.') +\n    '<div class=\"pil\" style=\"margin-bottom:14px\"><button class=\"tb tbe\" onclick=\"formTempel()\">📋 Tempel data siswa sekaligus (dari Excel / Sheet)</button></div><div id=\"swIsi\">' + memuat() + '</div>';\n  SWubah = {};\n  api('webSiswa').then(function (d) { SW = d; gambarSiswa(); }).catch(function (e) { $('swIsi').innerHTML = '<div class=\"kosong\" style=\"color:#c0392b\">' + aman(e.message) + '</div>'; });\n}\nfunction gambarSiswa(no) {\n  var terisi = SW.siswa.filter(function (s) { return s.isi[3]; });\n  var kosong = SW.siswa.filter(function (s) { return !s.isi[3]; })[0];\n  if (no && no !== SWpilih && Object.keys(SWubah).length) {\n    if (!confirm('Perubahan siswa ini belum disimpan. Pindah tanpa menyimpan?')) return;\n    SWubah = {}; setKotor(null);\n  }\n  SWpilih = no || SWpilih || (terisi[0] || kosong || {}).no;\n  var s = SW.siswa[SWpilih - 1];\n  var h = '<div class=\"dua\"><div class=\"daftar\"><input class=\"in cari\" placeholder=\"🔍 Cari nama…\" oninput=\"saringDaftar(this)\"><div class=\"isi\">' +\n    daftarSiswaHtml(terisi.map(function (x) { return { no: x.no, nama: x.isi[3] }; }), SWpilih, 'gambarSiswa') +\n    (kosong ? '<button class=\"s\" style=\"color:var(--h)\" onclick=\"gambarSiswa(' + kosong.no + ')\"><span class=\"nu\"></span><span class=\"av\" style=\"background:var(--e);color:#fff\">+</span><span class=\"nmm\">Tambah siswa (no. ' + kosong.no + ')</span></button>' : '') +\n    '</div></div><div class=\"blok\" style=\"margin:0\"><div class=\"hdr\"><div class=\"nmb\">' + aman(s.isi[3] || 'Siswa baru · no. ' + s.no) + (s.isi[4] ? '<small>' + aman(s.isi[4]) + '</small>' : '') + '</div>' +\n    (s.isi[3] ? '<button class=\"tb tbm tbk\" onclick=\"hapusSiswa(' + s.no + ')\">🗑 Hapus siswa</button>' : '') + '</div><div class=\"f\">';\n  GRUP_SISWA.forEach(function (g) {\n    h += '<div class=\"gj\">' + g[0] + '</div>' + g[1].map(function (k) {\n      var lab = SW.kolom[k], v = SWubah[k] != null ? SWubah[k] : s.isi[k], p = SW.pilihan[k], arab = /Arab/.test(lab);\n      var ctrl = p ? '<input class=\"in\" list=\"dlS' + k + '\" value=\"' + aman(v) + '\" oninput=\"ubahSiswa(' + k + ',this.value)\" placeholder=\"pilih / ketik\">' + datalist('dlS' + k, p)\n        : '<input class=\"in' + (arab ? ' ar' : '') + '\"' + (arab ? ' dir=\"rtl\" style=\"font-size:17px\"' : '') + ' value=\"' + aman(v) + '\" oninput=\"ubahSiswa(' + k + ',this.value)\"' +\n          (/Tanggal|Diterima Tanggal/.test(lab) ? ' placeholder=\"hh/bb/tttt\"' : '') + (/Telepon|NIS/.test(lab) ? ' inputmode=\"tel\"' : '') + '>';\n      return '<div class=\"fl' + (k === 3 || k === 11 ? ' pn' : '') + '\"><label>' + aman(lab) + (k === 3 ? ' *' : '') + '</label>' + ctrl + '</div>';\n    }).join('');\n  });\n  h += '</div></div></div>';\n  $('swIsi').innerHTML = h;\n}\nfunction hapusSiswa(no) {\n  var s = SW.siswa[no - 1], nama = s.isi[3];\n  kartu('<h3>Hapus ' + aman(nama) + '?</h3><p>Dipakai bila siswa <b>pindah / keluar</b>. Data diri, <b>semua nilai</b>, kehadiran, catatan, dan P5 siswa ini ikut dihapus. ' +\n    'Siswa sesudahnya naik satu nomor.<br><br>Ketik <b>HAPUS</b> untuk memastikan:</p><input class=\"in\" id=\"hpsYa\" placeholder=\"HAPUS\" autocomplete=\"off\">' +\n    '<p class=\"salah\" id=\"hpsSalah\"></p><div class=\"aksi\"><button class=\"tb tbg\" onclick=\"tutupKartu()\">Batal</button><button class=\"tb tbm\" id=\"hpsTb\">🗑 Hapus</button></div>');\n  $('hpsTb').onclick = function () {\n    if ($('hpsYa').value.trim().toUpperCase() !== 'HAPUS') { $('hpsSalah').textContent = 'Ketik HAPUS dulu.'; return; }\n    $('hpsTb').disabled = true; $('hpsTb').textContent = 'Menghapus… (± 30 detik)';\n    api('webHapusSiswa', no, nama).then(function (d) {\n      SW = d; SWubah = {}; SWpilih = null; setKotor(null); tutupKartu(); gambarSiswa(); DATA_CETAK = null; toast(nama + ' sudah dihapus');\n    }).catch(function (e) { $('hpsSalah').textContent = e.message; $('hpsTb').disabled = false; $('hpsTb').textContent = '🗑 Hapus'; });\n  };\n}\n// ---------------- tempel seluruh tabel: kolom dikenali dari judulnya\nvar SINONIM = {\n  1: ['nis', 'nomor induk', 'no induk', 'nomor induk siswa', 'nipd', 'nis lokal'], 2: ['nisn', 'nomor induk siswa nasional'],\n  3: ['nama', 'nama siswa', 'nama lengkap', 'nama peserta didik', 'nama santri', 'nama murid'],\n  4: ['nama arab', 'nama tulisan arab', 'nama dalam tulisan arab', 'nama siswa arab'],\n  5: ['l/p', 'lp', 'jk', 'jenis kelamin', 'kelamin', 'gender', 'jns kelamin'], 6: ['tempat lahir', 'tmp lahir', 'tempat lhr'],\n  7: ['tanggal lahir', 'tgl lahir', 'tgl lhr', 'tanggal lhr'], 8: ['agama'], 9: ['status dalam keluarga', 'status keluarga', 'status anak', 'status'],\n  10: ['anak ke', 'anak ke-', 'anak keberapa'], 11: ['alamat', 'alamat siswa', 'alamat peserta didik', 'alamat santri', 'alamat rumah'],\n  12: ['telepon', 'no telepon', 'telepon siswa', 'no hp', 'hp', 'telp', 'no telp', 'no hp siswa', 'nomor hp'],\n  13: ['sekolah asal', 'asal sekolah'], 14: ['diterima di kelas', 'kelas diterima', 'diterima kelas'],\n  15: ['diterima tanggal', 'tanggal diterima', 'tgl diterima', 'diterima pada tanggal', 'tanggal masuk', 'tgl masuk'],\n  16: ['nama ayah', 'ayah', 'nama ayah kandung'], 17: ['nama ayah arab', 'nama ayah tulisan arab'], 18: ['nama ibu', 'ibu', 'nama ibu kandung'],\n  19: ['alamat orang tua', 'alamat ortu', 'alamat orangtua'], 20: ['telepon orang tua', 'no hp orang tua', 'hp orang tua', 'telepon ortu', 'no hp ortu', 'hp ortu', 'no telp orang tua', 'telp orang tua'],\n  21: ['pekerjaan ayah'], 22: ['pekerjaan ibu'], 23: ['nama wali', 'wali'], 24: ['alamat wali'], 25: ['telepon wali', 'hp wali', 'no hp wali', 'telp wali'], 26: ['pekerjaan wali'],\n  ttl: ['ttl', 'tempat tanggal lahir', 'tempat/tanggal lahir', 'tempat dan tanggal lahir', 'tempat tgl lahir'],\n  no: ['no', 'no.', 'nomor', 'no urut', 'nomor urut']\n};\nfunction rapikanJudul(t) { return String(t || '').toLowerCase().replace(/\\(.*?\\)/g, function (m) { return /arab/.test(m) ? ' arab' : ''; }).replace(/[^a-z0-9\\/ ]/g, ' ').replace(/\\s+/g, ' ').trim(); }\nfunction kenaliJudul(t) {\n  var j = rapikanJudul(t);\n  if (!j) return null;\n  for (var k in SINONIM) if (SINONIM[k].some(function (x) { return rapikanJudul(x) === j; })) return k;\n  for (var i = 1; i <= 26; i++) if (rapikanJudul(SW.kolom[i]) === j) return String(i);\n  return null;\n}\nfunction bacaTempel() {\n  return $('tpData').value.replace(/\\r/g, '').split('\\n').filter(function (b) { return b.trim(); }).map(function (b) { return b.split('\\t'); });\n}\nfunction nilaiLp(x) {\n  var t = String(x || '').trim().toLowerCase();\n  if (/^(l|lk|laki|laki-laki|laki laki|pria|putra)$/.test(t)) return 'L';\n  if (/^(p|pr|perempuan|wanita|putri)$/.test(t)) return 'P';\n  return String(x || '').trim();\n}\n// hasil: { judul: bool, peta: [kode per kolom], diabaikan: [judul], data: [[null, ...26]] }\nfunction olahTempel() {\n  var b = bacaTempel();\n  if (!b.length) return null;\n  var lebar = Math.max.apply(null, b.map(function (r) { return r.length; }));\n  var tebak = b[0].map(kenaliJudul), dikenal = tebak.filter(function (x) { return x && x !== 'no'; }).length;\n  var judul = dikenal >= 2, peta = [], diabaikan = [];\n  if (judul) {\n    var dipakai = {};\n    b[0].forEach(function (t, i) {\n      var k = tebak[i];\n      if (k && k !== 'no' && !dipakai[k]) { peta[i] = k; dipakai[k] = 1; }\n      else { peta[i] = null; if (String(t).trim() && k !== 'no') diabaikan.push(String(t).trim()); }\n    });\n    b = b.slice(1);\n  } else {\n    var awal = +$('tpKol').value, mulai = 0;\n    var urut = b.every(function (r, i) { return String(r[0]).trim() === String(i + 1); });   // kolom nomor urut 1,2,3,...\n    if (urut && b.length > 1) { peta[0] = null; mulai = 1; }\n    for (var j = mulai; j < lebar; j++) peta[j] = awal + j - mulai <= 26 ? String(awal + j - mulai) : null;\n  }\n  var data = b.map(function (r) {\n    var o = []; for (var k = 0; k <= 26; k++) o.push(null);\n    r.forEach(function (x, i) {\n      var k = peta[i]; if (!k) return;\n      x = String(x == null ? '' : x).trim();\n      if (k === 'ttl') {                                   // \"Tarakan, 13 Mei 2011\" -> tempat + tanggal\n        var p = x.split(/,\\s*/); o[6] = p[0] || ''; o[7] = p.slice(1).join(', '); return;\n      }\n      o[+k] = k === '5' ? nilaiLp(x) : x;\n    });\n    return o;\n  }).filter(function (o) { return o.some(function (x) { return x; }); });\n  return { judul: judul, peta: peta, diabaikan: diabaikan, data: data };\n}\nfunction formTempel() {\n  if (!SW) return;\n  var ada = SW.siswa.filter(function (s) { return s.isi[3]; }).length;\n  kartu('<h3>Tempel data siswa sekaligus</h3><p>1. Buka data lama (Excel / Google Sheet), <b>blok seluruh tabelnya beserta baris judul kolomnya</b>, lalu tekan <b>Ctrl + C</b>.<br>' +\n    '2. Klik kotak di bawah, tekan <b>Ctrl + V</b>. Kolom dikenali sendiri dari judulnya.</p>' +\n    '<textarea class=\"in\" id=\"tpData\" style=\"min-height:110px;font-size:12px;white-space:pre\" placeholder=\"Tempel di sini (Ctrl + V)\" oninput=\"pratinjauTempel()\"></textarea>' +\n    '<div id=\"tpLihat\" style=\"font-size:12.5px;color:#444;margin-top:10px\"></div>' +\n    '<div class=\"f\" style=\"margin-top:10px\"><div class=\"fl\"><label>Mulai dari siswa nomor</label><input class=\"in\" id=\"tpNo\" inputmode=\"numeric\" value=\"1\" oninput=\"pratinjauTempel()\"></div>' +\n    '<div class=\"fl\" id=\"tpKolBox\" hidden><label>Data tanpa judul: kolom pertama adalah</label><select class=\"in\" id=\"tpKol\" onchange=\"pratinjauTempel()\">' +\n    SW.kolom.slice(1, 27).map(function (k, i) { return '<option value=\"' + (i + 1) + '\"' + (i + 1 === 1 ? ' selected' : '') + '>' + aman(k) + '</option>'; }).join('') + '</select></div></div>' +\n    '<p class=\"salah\" id=\"tpSalah\"></p><div class=\"aksi\"><button class=\"tb tbg\" onclick=\"tutupKartu()\">Batal</button><button class=\"tb tbh\" id=\"tpTb\" onclick=\"simpanTempel()\">Simpan</button></div>');\n  $('kartu').style.maxWidth = '720px';\n  setTimeout(function () { $('tpData').focus(); }, 50);\n}\nfunction pratinjauTempel() {\n  var h = olahTempel();\n  if (!h) { $('tpLihat').innerHTML = ''; $('tpKolBox').hidden = true; return; }\n  $('tpKolBox').hidden = h.judul;\n  var no = parseInt($('tpNo').value, 10) || 1, kol = [];\n  h.peta.forEach(function (k) { if (k && kol.indexOf(k) < 0) kol.push(k); });\n  var nama = function (k) { return k === 'ttl' ? 'Tempat & Tanggal Lahir' : SW.kolom[+k]; };\n  var timpa = SW.siswa.slice(no - 1, no - 1 + h.data.length).filter(function (s) { return s.isi[3]; }).length;\n  var tampil = kol.map(function (k) { return k === 'ttl' ? ['6', '7'] : [k]; }).reduce(function (a, b) { return a.concat(b); }, []);\n  $('tpLihat').innerHTML = '<div style=\"margin-bottom:6px\"><b>' + h.data.length + ' siswa</b> akan diisi ke nomor ' + no + '–' + (no + h.data.length - 1) + '.' +\n    (no + h.data.length - 1 > 40 ? ' <span style=\"color:#c0392b\">Melebihi 40 siswa!</span>' : '') +\n    (timpa ? '<br><span style=\"color:#c0392b\">⚠ ' + timpa + ' siswa yang sudah ada di nomor itu akan ditimpa (kolom yang ditempel saja).</span>' : '') + '</div>' +\n    '<div class=\"cek\" style=\"margin-bottom:6px\">' + kol.map(function (k) { return '<label style=\"cursor:default;background:#e8f1eb;border-color:#0F5132\">✓ ' + aman(nama(k)) + '</label>'; }).join('') +\n    h.diabaikan.map(function (t) { return '<label style=\"cursor:default;color:#999\">✗ ' + aman(t) + ' (dilewati)</label>'; }).join('') + '</div>' +\n    '<div class=\"bungkus\" style=\"max-height:150px\"><table class=\"tn\"><thead><tr><th>No</th>' + tampil.map(function (k) { return '<th>' + aman(SW.kolom[+k]) + '</th>'; }).join('') + '</tr></thead><tbody>' +\n    h.data.slice(0, 3).map(function (r, i) { return '<tr><td>' + (no + i) + '</td>' + tampil.map(function (k) { return '<td style=\"text-align:left\">' + aman(r[+k] || '') + '</td>'; }).join('') + '</tr>'; }).join('') +\n    '</tbody></table></div>' + (h.data.length > 3 ? '<div style=\"font-size:11.5px;color:#999;margin-top:4px\">… dan ' + (h.data.length - 3) + ' siswa lagi</div>' : '');\n}\nfunction simpanTempel() {\n  var h = olahTempel();\n  if (!h || !h.data.length) { $('tpSalah').textContent = 'Belum ada data yang ditempel.'; return; }\n  if (!h.data.some(function (r) { return r.some(function (x) { return x; }); })) { $('tpSalah').textContent = 'Tidak ada kolom yang dikenali.'; return; }\n  $('tpTb').disabled = true; $('tpTb').textContent = 'Menyimpan…';\n  api('webTempelSiswa', parseInt($('tpNo').value, 10) || 1, h.data).then(function (d) {\n    SW = d; SWubah = {}; tutupKartu(); gambarSiswa(); DATA_CETAK = null; toast(h.data.length + ' siswa tersimpan ✓');\n  }).catch(function (e) { $('tpSalah').textContent = e.message; $('tpTb').disabled = false; $('tpTb').textContent = 'Simpan'; });\n}\nfunction ubahSiswa(k, v) { SWubah[k] = v; setKotor(simpanSiswa, 'Data siswa belum disimpan'); }\nfunction simpanSiswa() {\n  return api('webSimpanSiswa', SWpilih, SWubah).then(function (d) {\n    SW = d; SWubah = {}; setKotor(null); gambarSiswa(); DATA_CETAK = null;\n  });\n}\n\n// =================================================================== pengaturan\nvar AT = null, ATubah = {};\nfunction halAtur() {\n  $('isi').innerHTML = judul('Wali kelas', 'Pengaturan', 'Diisi sekali setiap semester. Semua halaman raport mengambil data dari sini.') + '<div id=\"atIsi\" class=\"atur\">' + memuat() + '</div>';\n  ATubah = {};\n  api('webPengaturan').then(function (d) { AT = d; gambarAtur(); }).catch(function (e) { $('atIsi').innerHTML = '<div class=\"kosong\" style=\"color:#c0392b\">' + aman(e.message) + '</div>'; });\n}\nfunction gambarAtur() {\n  var h = '', pertama = true;\n  AT.isi.forEach(function (x) {\n    if (x.judul) {\n      var besar = /^[A-Z &()]+$/.test(x.judul.replace(/[^A-Za-z &()]/g, '')) && x.judul === x.judul.toUpperCase();\n      h += '<div class=\"ah' + (besar ? '' : ' kc') + '\">' + aman(besar ? x.judul.charAt(0) + x.judul.slice(1).toLowerCase() : x.judul) + '</div>';\n      return;\n    }\n    var arab = /Arab|Hijriah/.test(x.label) && !x.pilihan;\n    var ctrl;\n    if (x.otomatis) ctrl = '<div class=\"oto' + (/[؀-ۿ]/.test(x.nilai) ? ' ar' : '') + '\">' + aman(x.nilai || '–') + '</div>';\n    else if (x.pilihan) ctrl = '<select class=\"in\" onchange=\"ATubah[' + x.r + ']=this.value;setKotor(simpanAtur)\">' +\n      (x.pilihan.indexOf(x.nilai) < 0 ? '<option selected>' + aman(x.nilai) + '</option>' : '') +\n      x.pilihan.map(function (p) { return '<option' + (p === x.nilai ? ' selected' : '') + '>' + aman(p) + '</option>'; }).join('') + '</select>';\n    else if (x.panjang) ctrl = '<textarea class=\"in\" style=\"min-height:70px\" oninput=\"ATubah[' + x.r + ']=this.value;setKotor(simpanAtur)\">' + aman(x.nilai) + '</textarea>';\n    else ctrl = '<input class=\"in' + (arab ? ' ar' : '') + '\"' + (arab ? ' dir=\"rtl\" style=\"font-size:17px\"' : '') + ' value=\"' + aman(x.nilai) + '\" oninput=\"ATubah[' + x.r + ']=this.value;setKotor(simpanAtur)\">';\n    h += '<div class=\"ab' + (x.sub ? ' sub' : '') + '\"><div class=\"lb\">' + aman(x.label) + (x.otomatis ? ' <small style=\"color:#999\">(otomatis)</small>' : '') + '</div>' + ctrl + '</div>';\n  });\n  $('atIsi').innerHTML = h || '<div class=\"kosong\">Pengaturan tidak terbaca.</div>';\n}\nfunction simpanAtur() {\n  var ubah = Object.keys(ATubah).map(function (r) { return { r: +r, v: ATubah[r] }; });\n  return api('webSimpanPengaturan', ubah).then(function (d) {\n    AT = d; ATubah = {}; setKotor(null); gambarAtur(); DATA_CETAK = null;\n    panggil('webDepan').then(function (x) { DEPAN = x; masukUlangKepala(); });\n  });\n}\nfunction masukUlangKepala() {\n  $('hdSekolah').textContent = DEPAN.sekolah || '';\n  $('chips').innerHTML = [DEPAN.kelas && 'Kelas ' + DEPAN.kelas, DEPAN.semester && 'Semester ' + DEPAN.semester, DEPAN.tahun]\n    .filter(Boolean).map(function (t) { return '<span class=\"chip\">' + aman(t) + '</span>'; }).join('');\n}\n\n// =================================================================== guru & link WA\nvar AK = null;\nfunction halAkun() {\n  $('isi').innerHTML = judul('Wali kelas', 'Guru & Link WA', 'Satu guru = satu akun. Guru menerima link khusus lewat WhatsApp dan hanya bisa mengisi mapel yang dicentang.') + '<div id=\"akIsi\">' + memuat() + '</div>';\n  api('webAkun').then(function (d) { AK = d; gambarAkun(); }).catch(function (e) { $('akIsi').innerHTML = '<div class=\"kosong\" style=\"color:#c0392b\">' + aman(e.message) + '</div>'; });\n}\nfunction nomorWa(hp) {\n  var n = String(hp || '').replace(/[^0-9]/g, '');\n  if (n.charAt(0) === '0') n = '62' + n.slice(1); else if (n.charAt(0) === '8') n = '62' + n;\n  return n;\n}\nfunction linkGuru(a) { return AK.url ? AK.url + (AK.url.indexOf('?') >= 0 ? '&' : '?') + 'k=' + a.kode : ''; }\nfunction pesanWa(a) {\n  var mp = a.mapel.join(', ') + (a.p5 ? (a.mapel.length ? ' dan ' : '') + 'Projek P5' : '');\n  return 'Assalamu\\'alaikum ' + a.nama + '.\\nMohon bantuannya mengisi nilai *' + mp + '* kelas ' + (AK.kelas || '') + ' semester ' + (AK.semester || '') +\n    ' lewat link berikut:\\n' + linkGuru(a) + '\\n\\nLink ini khusus untuk Ustadz/Ibu, mohon tidak disebarkan. Setelah mengisi, tekan tombol Simpan. Jazakumullah khairan.';\n}\nfunction kirimWa(id) {\n  var a = AK.akun.filter(function (x) { return x.id === id; })[0];\n  if (!AK.url) { kartu('<h3>Link aplikasi belum ada</h3><p>Aplikasi web belum diterbitkan (Terapkan › Deployment baru › Aplikasi web).</p><div class=\"aksi\"><button class=\"tb tbg\" onclick=\"tutupKartu()\">Tutup</button></div>'); return; }\n  if (!a.mapel.length && !a.p5) { toast('Centang dulu mapel guru ini (tombol Ubah).', true); return; }\n  var no = nomorWa(a.hp);\n  window.open('https://wa.me/' + no + '?text=' + encodeURIComponent(pesanWa(a)), '_blank');\n}\nfunction salinLink(id) {\n  var a = AK.akun.filter(function (x) { return x.id === id; })[0], t = pesanWa(a);\n  kartu('<h3>Pesan untuk ' + aman(a.nama) + '</h3><p>Salin pesan ini bila ingin dikirim lewat aplikasi lain.</p><textarea class=\"in\" id=\"psn\" style=\"min-height:170px;font-size:13px\">' + aman(t) + '</textarea>' +\n    '<div class=\"aksi\"><button class=\"tb tbg\" onclick=\"tutupKartu()\">Tutup</button><button class=\"tb tbh\" onclick=\"$(\\'psn\\').select();document.execCommand(\\'copy\\');toast(\\'Pesan disalin ✓\\')\">Salin</button></div>');\n}\nfunction gambarAkun() {\n  var guru = AK.akun.filter(function (a) { return a.peran !== 'wali'; }), wali = AK.akun.filter(function (a) { return a.peran === 'wali'; });\n  var baris = function (a) {\n    var m = a.peran === 'wali' ? 'semua halaman' : (a.mapel.join(', ') || 'belum ada mapel') + (a.p5 ? ' · P5' : '');\n    return '<div class=\"akl\"><span class=\"av\">' + aman(inisial(a.nama)) + '</span><div class=\"nm\"><b>' + aman(a.nama) + (a.peran === 'wali' ? '<span class=\"wali\">WALI KELAS</span>' : '') + '</b><small>' +\n      aman(m) + (a.hp ? ' · ' + aman(a.hp) : '') + '</small></div>' +\n      (a.peran !== 'wali' ? '<button class=\"tb tbe tbk\" onclick=\"kirimWa(\\'' + a.id + '\\')\"' + (a.hp ? '' : ' disabled title=\"Isi nomor HP dulu\"') + '>📲 Kirim WA</button>' : '') +\n      '<button class=\"tb tbg tbk\" onclick=\"formAkun(\\'' + a.id + '\\')\">Ubah</button></div>';\n  };\n  $('akIsi').innerHTML = '<div class=\"blok\" style=\"max-width:820px\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;gap:10px;flex-wrap:wrap\"><h3 style=\"margin:0\">Guru mapel · ' + guru.length + ' akun</h3>' +\n    '<button 