-family:'Noto Naskh Arabic',serif;font-weight:700;min-height:8px}\n.meta{font-size:13px;font-weight:600;color:#6f6f6f;margin-top:4px}\n.orn{height:2px;background:linear-gradient(90deg,var(--e),rgba(184,147,46,0));margin:12px 0}\n.stat{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}\n.c{background:#fff;border:1.5px solid #ece4cc;border-radius:14px;padding:10px 12px 9px}\n.c .k{font-size:10px;letter-spacing:1px;color:var(--abu);font-weight:700;white-space:nowrap;text-transform:uppercase}\n.c .v{font-family:'Playfair Display',serif;font-weight:800;font-size:28px;color:var(--h);line-height:1.15;margin-top:2px;white-space:nowrap}\n.c .v small{font-family:Poppins;font-size:12px;font-weight:600;color:#888}\n.c .x{font-size:11px;color:#8b8b8b;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.c.ok .v{font-size:17px;font-family:Poppins;font-weight:700;color:#2e8b57;margin-top:8px}\n.c.bl .v{font-size:17px;font-family:Poppins;font-weight:700;color:#c0392b;margin-top:8px}\n.sec{font-size:11.5px;letter-spacing:2.5px;color:var(--e);font-weight:700;margin:14px 0 8px;text-transform:uppercase}\n.sec .sub{letter-spacing:0;color:var(--abu);font-weight:600;font-size:12px;text-transform:none}\n.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\n.tl{display:flex;align-items:center;gap:10px;border-radius:14px;padding:11px 12px;font-size:14.5px;font-weight:700;white-space:nowrap;text-align:left;transition:transform .1s}\n.tl:hover,.bk:hover{transform:translateY(-1px)}\n.tl .i{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;flex:none}\n.tl small{display:block;font-weight:500;font-size:11.5px;opacity:.85}\n.t1{background:linear-gradient(120deg,var(--h2),var(--h));color:#fff;box-shadow:0 8px 18px rgba(15,81,50,.3)} .t1 .i{background:rgba(255,255,255,.14)}\n.t2{background:linear-gradient(120deg,#a37c22,#cda748);color:#fff;box-shadow:0 8px 18px rgba(184,147,46,.3)} .t2 .i{background:rgba(255,255,255,.2)}\n.t3{background:#fff;color:var(--h);border:2px solid var(--h)} .t3 .i{background:#e8f1eb}\n.sk{background:#fff;border:1.5px solid #ece4cc;border-radius:14px;padding:10px;display:flex;flex-direction:column;gap:9px}\n.opts{display:flex;gap:7px;flex-wrap:wrap}\n.cb{font-size:13px;font-weight:600;padding:6px 11px;border-radius:10px;border:1.5px solid #ddd3b8;color:#777;background:#fff;white-space:nowrap}\n.cb.on{background:#e8f1eb;border-color:var(--h);color:var(--h)}\n.bk{display:flex;align-items:center;gap:12px;border-radius:12px;padding:10px 14px;font-size:16px;font-weight:700;background:linear-gradient(120deg,var(--h2),var(--h));color:#fff;box-shadow:0 8px 18px rgba(15,81,50,.28);text-align:left;width:100%}\n.bk .i{width:38px;height:38px;border-radius:11px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-size:18px}\n.bk small{display:block;font-weight:500;font-size:12px;opacity:.85}\n.bk .ar2{margin-left:auto;font-size:22px;opacity:.75}\n.once{margin-top:auto;padding-top:10px;border-top:1px dashed #ddd3b8;display:flex;align-items:center;gap:6px;flex-wrap:wrap}\n.once.saran{border:1.5px solid var(--e);border-radius:12px;padding:10px;background:#fffaf0;margin-top:14px}\n.ol{width:100%;font-size:12.5px;font-weight:700;color:#8a8170}\n.ol small{font-weight:500;color:#a9a08a}\n.ol b{color:#a37c22}\n.cb2{font-size:11.5px;font-weight:600;padding:5px 8px;border-radius:8px;border:1.5px solid #ddd3b8;color:#8a8170;background:#fff;white-space:nowrap}\n.cb2.on{background:#f7f0dc;border-color:var(--e);color:#7a5c12}\n.sp{flex:1}\n.ob{font-size:12px;font-weight:700;color:var(--h);border:1.5px solid var(--h);border-radius:9px;padding:5px 10px;background:#fdfcf8;white-space:nowrap}\n/* kanan */\n.kanan{width:340px;flex:none;padding:16px 20px 12px 0;display:flex;flex-direction:column}\n.tabs{display:flex;gap:5px;margin-bottom:10px;flex-wrap:wrap}\n.tb{font-size:12px;font-weight:600;padding:5px 10px;border-radius:16px;border:1.5px solid #ddd3b8;color:#666;background:#fff;white-space:nowrap}\n.tb.on{background:var(--h);color:#fff;border-color:var(--h)}\n.paper{flex:1;background:#fff;border-radius:8px;box-shadow:0 14px 34px rgba(0,0,0,.18),0 0 0 1px #eee;padding:8px;overflow:hidden;position:relative;cursor:zoom-in;display:flex;align-items:flex-start;justify-content:center}\n.paper canvas{max-width:100%;max-height:100%}\n.zoom{text-align:center;font-size:11.5px;font-weight:600;color:var(--abu);margin-top:8px}\n.muat{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:rgba(255,255,255,.85);font-size:12.5px;color:var(--abu);font-weight:600;text-align:center;padding:20px}\n.putar{width:34px;height:34px;border:3px solid #e8f1eb;border-top-color:var(--h);border-radius:50%;animation:p 0.9s linear infinite}\n@keyframes p{to{transform:rotate(360deg)}}\n.ft{flex:none;height:34px;border-top:1px solid var(--garis);display:flex;align-items:center;justify-content:space-between;padding:0 20px;font-size:11.5px;font-weight:600;color:var(--abu);background:#fff}\n/* lapisan */\n.lapis{position:fixed;inset:0;background:rgba(15,30,22,.6);display:none;align-items:center;justify-content:center;z-index:9}\n.lapis.buka{display:flex}\n.kartu{background:#fff;border-radius:16px;padding:26px 30px;width:440px;text-align:center;box-shadow:0 24px 60px rgba(0,0,0,.35)}\n.kartu h3{font-family:'Playfair Display',serif;font-size:24px;color:var(--h);margin-bottom:8px}\n.kartu p{font-size:13.5px;color:#555;margin-bottom:16px;line-height:1.5}\n.bar{height:10px;background:#eef3ef;border-radius:6px;overflow:hidden;margin:6px 0 14px}\n.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--h),var(--e));transition:width .4s}\n.tbl{display:inline-block;background:linear-gradient(120deg,var(--h2),var(--h));color:#fff;padding:11px 22px;border-radius:12px;font-weight:700;text-decoration:none;font-size:14.5px}\n.tbl2{display:inline-block;margin-left:8px;padding:10px 18px;border-radius:12px;border:1.5px solid #ddd3b8;font-weight:600;color:#666;font-size:14px}\n.besar{position:fixed;inset:0;background:rgba(20,24,22,.85);display:none;z-index:8;overflow:auto;padding:24px;text-align:center}\n.besar.buka{display:block}\n.besar canvas{display:block;margin:0 auto 18px;box-shadow:0 10px 30px rgba(0,0,0,.5);max-width:100%;background:#fff}\n.tutup{position:fixed;top:14px;right:22px;color:#fff;font-size:30px;z-index:9}\n</style></head>\n<body>\n<div class=\"hd\"><img src=\"data:image/png;base64,\" alt=\"\">\n  <div class=\"brand\"><div class=\"t\">Smart<b>Rapor</b></div><div class=\"u\" id=\"sekolah\">&nbsp;</div></div>\n  <div class=\"chips\" id=\"chips\"></div>\n</div>\n<div class=\"bd\">\n  <div class=\"kiri\">\n    <div class=\"lh\"><div class=\"lab\">Daftar siswa</div><div class=\"lt\">Pilih Siswa<small id=\"jml\"></small></div></div>\n    <input class=\"cari\" id=\"cari\" placeholder=\"🔍  Cari nama siswa…\" oninput=\"isiDaftar()\">\n    <div class=\"list\" id=\"daftar\"><div style=\"padding:20px;color:#999;font-size:13px\">Memuat data siswa…</div></div>\n  </div>\n  <div class=\"tengah\">\n    <div class=\"lab\">Siswa terpilih</div>\n    <div class=\"nmb\" id=\"nama\">—</div><div class=\"ar\" id=\"arab\" dir=\"rtl\" style=\"text-align:left\"></div>\n    <div class=\"meta\" id=\"meta\">&nbsp;</div>\n    <div class=\"orn\"></div>\n    <div class=\"stat\">\n      <div class=\"c\"><div class=\"k\">Rata-rata</div><div class=\"duo\"><div><small>Sekolah</small><b id=\"rata\">–</b></div><div><small>Pondok</small><b id=\"rataP\">–</b></div></div></div>\n      <div class=\"c\"><div class=\"k\">Peringkat</div><div class=\"duo\"><div><small>Sekolah</small><b id=\"rank\">–</b></div><div><small>Pondok</small><b id=\"rankP\">–</b></div></div></div>\n      <div class=\"c\"><div class=\"k\" id=\"absenK\">Tidak hadir</div><div class=\"duo\"><div><small>Sakit</small><b id=\"absS\">0</b></div><div><small>Izin</small><b id=\"absI\">0</b></div><div><small>Alpa</small><b id=\"absA\">0</b></div></div></div>\n      <div class=\"c\" id=\"kStatus\"><div class=\"k\">Status nilai</div><div class=\"v\" id=\"status\">–</div><div class=\"x\" id=\"kurang\">&nbsp;</div></div>\n    </div>\n    <div class=\"sec\">Cetak siswa ini</div>\n    <div class=\"row3\">\n      <button class=\"tl t1\" onclick=\"cetak(['sekolah'],false)\"><span class=\"i\">🖨️</span><div>Raport Sekolah<small>siswa ini · PDF</small></div></button>\n      <button class=\"tl t2\" onclick=\"cetak(['pondok'],false)\"><span class=\"i\">📗</span><div>Raport Pondok<small>1 halaman, Arab</small></div></button>\n      <button class=\"tl t3\" onclick=\"cetak(['p5'],false)\"><span class=\"i\">🌱</span><div>Raport P5<small>Profil Pancasila</small></div></button>\n    </div>\n    <div class=\"sec\">Cetak sekelas <span class=\"sub\">— pilih yang mau dicetak</span></div>\n    <div class=\"sk\">\n      <div class=\"opts\" id=\"optKelas\">\n        <button class=\"cb on\" data-j=\"sekolah\" onclick=\"tukar(this)\">☑ Raport Sekolah</button>\n        <button class=\"cb on\" data-j=\"pondok\" onclick=\"tukar(this)\">☑ Raport Pondok</button>\n        <button class=\"cb\" data-j=\"p5\" onclick=\"tukar(this)\">☐ Raport P5 (Pancasila)</button>\n      </div>\n      <button class=\"bk\" onclick=\"cetakKelas()\"><span class=\"i\">📚</span><div>Cetak Sekelas<small id=\"ringkas\">&nbsp;</small></div><span class=\"ar2\">›</span></button>\n    </div>\n    <div class=\"once\" id=\"once\">\n      <span class=\"ol\" id=\"onceL\">📁 Cetak sekali saja <small>(awal kelas VII / siswa pindahan / ganti yang rusak)</small></span>\n      <button class=\"cb2 on\" data-j=\"cover\" onclick=\"tukar(this)\">☑ Cover</button>\n      <button class=\"cb2\" data-j=\"identitas\" onclick=\"tukar(this)\">☐ Identitas Sekolah</button>\n      <button class=\"cb2\" data-j=\"diri\" onclick=\"tukar(this)\">☐ Keterangan Diri</button>\n      <span class=\"sp\"></span>\n      <button class=\"ob\" onclick=\"cetakSekali(false)\">Siswa ini</button>\n      <button class=\"ob\" onclick=\"cetakSekali(true)\">Sekelas</button>\n    </div>\n  </div>\n  <div class=\"kanan\">\n    <div class=\"tabs\" id=\"tabs\">\n      <button class=\"tb on\" data-t=\"sekolah\">Sekolah</button><button class=\"tb\" data-t=\"pondok\">Pondok</button>\n      <button class=\"tb\" data-t=\"p5\">P5</button><button class=\"tb\" data-t=\"cover\">Cover</button>\n      <button class=\"tb\" data-t=\"identitas\">Identitas</button><button class=\"tb\" data-t=\"diri\">Ket. Diri</button>\n    </div>\n    <div class=\"paper\" id=\"kertas\" onclick=\"perbesar()\"><canvas id=\"kanvas\"></canvas>\n      <div class=\"muat\" id=\"muat\"><div class=\"putar\"></div><div id=\"muatT\">Menyiapkan gambar raport…</div></div></div>\n    <div class=\"zoom\">Klik gambar untuk memperbesar</div>\n  </div>\n</div>\n<div class=\"ft\"><span>SmartRapor · Kurikulum Merdeka</span><span>Klik nama siswa, lalu pilih tombol cetak</span></div>\n\n<div class=\"lapis\" id=\"lapis\"><div class=\"kartu\" id=\"kartu\"></div></div>\n<div class=\"besar\" id=\"besar\"><button class=\"tutup\" onclick=\"tutupBesar()\">✕</button><div id=\"besarIsi\"></div></div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n<script>\nvar KUNCI = '__KUNCI__';\nvar D = null, pilihNo = null, tab = 'sekolah', tokenPv = 0, pdfSaatIni = null;\nvar NAMA_JENIS = { sekolah: 'Raport Sekolah', pondok: 'Raport Pondok', p5: 'Raport P5', cover: 'Cover',\n                   identitas: 'Identitas Sekolah', diri: 'Keterangan Diri' };\n\n// pdf.js: pekerja dimuat lewat blob supaya jalan di dalam jendela Google\nvar siapPdf = (function () {\n  var src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';\n  return fetch(src).then(function (r) { return r.text(); }).then(function (t) {\n    pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([t], { type: 'text/javascript' }));\n  }).catch(function () { pdfjsLib.GlobalWorkerOptions.workerSrc = src; });\n})();\n\nfunction jalankan(fn) {\n  var args = Array.prototype.slice.call(arguments, 1);\n  return new Promise(function (ok, gagal) {\n    var r = google.script.run.withSuccessHandler(ok).withFailureHandler(gagal);\n    r[fn].apply(r, [KUNCI].concat(args));\n  });\n}\nfunction $(id) { return document.getElementById(id); }\nfunction aman(t) { return String(t == null ? '' : t).replace(/[&<>\"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]; }); }\nfunction angka(x, d) { return x === '' || x == null ? '–' : Number(x).toFixed(d).replace('.', ','); }\n\njalankan('dataPanel').then(function (d) {\n  D = d;\n  $('sekolah').textContent = d.sekolah || ' ';\n  $('chips').innerHTML = [d.kelas && 'Kelas ' + d.kelas, d.semester && 'Semester ' + d.semester, d.tahun]\n    .filter(Boolean).map(function (t) { return '<span class=\"chip\">' + aman(t) + '</span>'; }).join('');\n  var lengkap = d.siswa.filter(function (s) { return !s.kurang.length; }).length;\n  $('jml').textContent = d.siswa.length + ' siswa · ' + lengkap + ' lengkap';\n  if (d.saranCover) {\n    $('once').classList.add('saran');\n    $('onceL').innerHTML = '📁 <b>Saatnya cetak cover</b> <small>(kelas VII semester ganjil) — cukup sekali saja</small>';\n  }\n  isiDaftar(); ringkas();\n  if (d.siswa.length) pilihSiswa(d.dipilih || d.siswa[0].no);\n  else { $('muatT').textContent = 'Data siswa masih kosong. Isi dulu tab SISWA.'; document.querySelector('.putar').style.display = 'none'; }\n}).catch(function (e) { $('daftar').innerHTML = '<div style=\"padding:20px;color:#c0392b\">Gagal memuat: ' + aman(e.message) + '</div>'; });\n\nfunction isiDaftar() {\n  if (!D) return;\n  var q = $('cari').value.trim().toUpperCase();\n  $('daftar').innerHTML = D.siswa.filter(function (s) { return !q || s.nama.toUpperCase().indexOf(q) >= 0; })\n    .map(function (s) {\n      var ini = s.nama.split(/\\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join('');\n      var st = s.kurang.length ? '<span class=\"st no\" title=\"Belum ada nilai: ' + aman(s.kurang.join(', ')) + '\">belum</span>'\n                               : '<span class=\"st ok\">✓</span>';\n      return '<button class=\"s' + (s.no === pilihNo ? ' on' : '') + '\" onclick=\"pilihSiswa(' + s.no + ')\">' +\n        '<span class=\"nu\">' + ('0' + s.no).slice(-2) + '</span><span class=\"av\">' + aman(ini) + '</span>' +\n        '<span class=\"nm\">' + aman(s.nama) + '</span>' + st + '</button>';\n    }).join('') || '<div style=\"padding:16px;color:#999;font-size:13px\">Nama tidak ditemukan.</div>';\n}\n\nfunction cariSiswa(no) { return D.siswa.filter(function (s) { return s.no === no; })[0]; }\n\nfunction pilihSiswa(no) {\n  pilihNo = no; isiDaftar();\n  var s = cariSiswa(no); if (!s) return;\n  $('nama').textContent = s.nama;\n  $('arab').textContent = s.arab || '';\n  $('meta').textContent = [s.nisn && 'NISN ' + s.nisn, s.nis && 'NIS ' + s.nis].filter(Boolean).join('  ·  ') || ' ';\n  $('rata').textContent = angka(s.rata, 1);\n  $('rataP').textContent = angka(s.pondok, 0);\n  $('rank').innerHTML = s.peringkat ? s.peringkat + '<i> / ' + D.jumlahDinilai + '</i>' : '–';\n  $('rankP').innerHTML = s.peringkatPondok ? s.peringkatPondok + '<i> / ' + D.jumlahPondok + '</i>' : '–';\n  var tot = (+s.sakit || 0) + (+s.izin || 0) + (+s.alpa || 0);\n  $('absenK').textContent = 'Tidak hadir · ' + tot + ' hari';\n  $('absS').textContent = s.sakit || 0; $('absI').textContent = s.izin || 0; $('absA').textContent = s.alpa || 0;\n  $('kStatus').className = 'c ' + (s.kurang.length ? 'bl' : 'ok');\n  $('status').textContent = s.kurang.length ? '✗ Belum lengkap' : '✓ Lengkap';\n  $('kurang').textContent = s.kurang.length ? 'kosong: ' + s.kurang.join(', ') : ' ';\n  $('kurang').title = s.kurang.join(', ');\n  pratinjau();\n}\n\n// ---------------------------------------------------------------- gambar raport\ndocument.querySelectorAll('.tb').forEach(function (b) {\n  b.onclick = function () {\n    document.querySelectorAll('.tb').forEach(function (x) { x.classList.remove('on'); });\n    b.classList.add('on'); tab = b.dataset.t; pratinjau();\n  };\n});\n\nfunction pratinjau() {\n  if (!pilihNo) return;\n  var token = ++tokenPv;\n  $('muat').style.display = 'flex'; document.querySelector('.putar').style.display = '';\n  $('muatT').textContent = 'Menyiapkan gambar ' + NAMA_JENIS[tab] + '…';\n  jalankan('pratinjau', pilihNo, tab).then(function (daftar) {\n    if (token !== tokenPv) return;\n    return siapPdf.then(function () {\n      return Promise.all(daftar.map(function (b64) {\n        var bin = atob(b64), u = new Uint8Array(bin.length);\n        for (var i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i);\n        return pdfjsLib.getDocument({ data: u }).promise;\n      }));\n    }).then(function (dok) {\n      if (token !== tokenPv) return;\n      pdfSaatIni = dok;\n      return dok[0].getPage(1).then(function (hal) {\n        var kotak = $('kertas'), v1 = hal.getViewport({ scale: 1 });\n        var skala = Math.min((kotak.clientWidth - 16) / v1.width, (kotak.clientHeight - 16) / v1.height) * (window.devicePixelRatio || 1) * 1.5;\n        var vp = hal.getViewport({ scale: skala }), kv = $('kanvas');\n        kv.width = vp.width; kv.height = vp.height;\n        return hal.render({ canvasContext: kv.getContext('2d'), viewport: vp }).promise.then(function () {\n          if (token === tokenPv) $('muat').style.display = 'none';\n        });\n      });\n    });\n  }).catch(function (e) {\n    if (token !== tokenPv) return;\n    document.querySelector('.putar').style.display = 'none';\n    $('muatT').textContent = 'Gambar belum bisa ditampilkan: ' + e.message;\n  });\n}\n\nfunction perbesar() {\n  if (!pdfSaatIni) return;\n  var isi = $('besarIsi'); isi.innerHTML = ''; $('besar').classList.add('buka');\n  var lebar = Math.min(window.innerWidth - 60, 900);\n  pdfSaatIni.forEach(function (pdf) {\n    for (var n = 1; n <= pdf.numPages; n++) (function (n) {\n      var kv = document.createElement('canvas'); isi.appendChild(kv);\n      pdf.getPage(n).then(function (hal) {\n        var v1 = hal.getViewport({ scale: 1 }), vp = hal.getViewport({ scale: lebar / v1.width * 2 });\n        kv.width = vp.width; kv.height = vp.height; kv.style.width = lebar + 'px';\n        hal.render({ canvasContext: kv.getContext('2d'), viewport: vp });\n      });\n    })(n);\n  });\n}\nfunction tutupBesar() { $('besar').classList.remove('buka'); }\n\n// ---------------------------------------------------------------- pilihan centang\nfunction tukar(b) {\n  b.classList.toggle('on');\n  b.textContent = (b.classList.contains('on') ? '☑ ' : '☐ ') + b.textContent.slice(2);\n  ringkas();\n}\nfunction dicentang(sel) {\n  return Array.prototype.filter.call(document.querySelectorAll(sel), function (b) { return b.classList.contains('on'); })\n    .map(function (b) { return b.dataset.j; });\n}\nfunction ringkas() {\n  var j = dicentang('#optKelas .cb');\n  $('ringkas').textContent = (D ? D.siswa.length : 0) + ' siswa · ' + j.length + ' jenis raport · jadi 1 file PDF';\n}\n\n// ---------------------------------------------------------------- cetak\nfunction cetakKelas() { cetak(dicentang('#optKelas .cb'), true); }\nfunction cetakSekali(sekelas) { cetak(dicentang('.once .cb2'), sekelas); }\n\nfunction kartu(html) { $('kartu').innerHTML = html; $('lapis').classList.add('buka'); }\nfunction tutupKartu() { $('lapis').classList.remove('buka'); }\n\nfunction cetak(jenis, sekelas) {\n  if (!jenis.length) { kartu('<h3>Belum dipilih</h3><p>Centang dulu halaman yang mau dicetak.</p><button class=\"tbl2\" onclick=\"tutupKartu()\">Tutup</button>'); return; }\n  if (!sekelas && !pilihNo) return;\n  var id = 'c' + Date.now(), selesai = false;\n  var judul = sekelas ? 'Mencetak sekelas' : 'Mencetak ' + aman(cariSiswa(pilihNo).nama);\n  kartu('<h3>' + judul + '</h3><p id=\"pTeks\">Memulai…</p><div class=\"bar\"><i id=\"pBar\"></i></div>' +\n        '<p style=\"font-size:12px;color:#999;margin:0\">' + (sekelas ? 'Sekelas bisa 2–5 menit. Jangan tutup jendela ini.' : 'Biasanya kurang dari 1 menit.') + '</p>');\n  function tampil(p) {\n    if (!p || p.id !== id || selesai) return;\n    if (p.selesai) {\n      selesai = true;\n      if (p.galat) kartu('<h3>Cetak gagal</h3><p>' + aman(p.galat) + '<br><br>Foto pesan ini dan kirim ke admin.</p><button class=\"tbl2\" onclick=\"tutupKartu()\">Tutup</button>');\n      else kartu('<h3>PDF sudah jadi ✓</h3><p>' + p.pesan + '<br>Tersimpan di folder <b>PDF SmartRapor</b> di Google Drive.</p>' +\n        '<a class=\"tbl\" href=\"' + p.url + '\" target=\"_blank\">Buka PDF</a><button class=\"tbl2\" onclick=\"tutupKartu()\">Tutup</button>' +\n        '<p style=\"font-size:12px;color:#999;margin:14px 0 0\">Di halaman PDF, tekan ikon printer atau Ctrl + P.</p>');\n      return;\n    }\n    if ($('pTeks')) { $('pTeks').textContent = p.teks; $('pBar').style.width = (p.persen || 0) + '%'; }\n  }\n  function intip() {\n    if (selesai) return;\n    jalankan('progresCetak', id).then(tampil).catch(function () {}).then(function () { if (!selesai) setTimeout(intip, 1500); });\n  }\n  jalankan('cetakPanel', { id: id, jenis: jenis, sekelas: sekelas, no: pilihNo })\n    .then(function () { return jalankan('progresCetak', id).then(tampil); })\n    .catch(function (e) { if (!selesai) { selesai = true; kartu('<h3>Cetak gagal</h3><p>' + aman(e.message) + '</p><button class=\"tbl2\" onclick=\"tutupKartu()\">Tutup</button>'); } });\n  setTimeout(intip, 1500);\n}\n</script>\n</body></html>\n";

function bukaPanel() {
  if (!ui_()) return;
  // kunci panel: fungsi panel hanya mau dipanggil dari panel yang dibuka dari file ini
  var kunci = Utilities.getUuid();
  CacheService.getScriptCache().put('SR_PANEL_' + kunci, '1', 21600);
  var html = HtmlService.createHtmlOutput(PANEL_HTML.replace('__KUNCI__', kunci)).setWidth(1240).setHeight(760);
  SpreadsheetApp.getUi().showModalDialog(html, ' ');
}

// Panel terbuka sendiri saat file dibuka. Berlaku untuk akun yang menyalakannya saja
// (setiap guru menyalakan sendiri bila mau).
function panelOtomatisNyala() {
  if (!ui_()) return;
  hapusPemicuPanel_();
  ScriptApp.newTrigger('panelSaatBuka').forSpreadsheet(SpreadsheetApp.getActive()).onOpen().create();
  pesan_('Panel otomatis sudah NYALA.\n\nMulai sekarang, setiap kali Ustadz/Ibu membuka file ini, ' +
    'Panel SmartRapor langsung terbuka sendiri.\n\nUntuk mematikan: menu SmartRapor › Panel terbuka otomatis: MATIKAN.');
}

function panelOtomatisMati() {
  if (!ui_()) return;
  var n = hapusPemicuPanel_();
  pesan_(n ? 'Panel otomatis sudah MATI.\n\nPanel bisa dibuka lewat tombol emas di BERANDA.' :
    'Panel otomatis memang belum dinyalakan.');
}

function hapusPemicuPanel_() {
  var n = 0;
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'panelSaatBuka') { ScriptApp.deleteTrigger(t); n++; }
  });
  return n;
}

function panelSaatBuka(e) {
  if (!e) return;
  try {
    var pembuka = e && e.user ? String(e.user.getEmail ? e.user.getEmail() : e.user) : '';
    var pemilik = Session.getEffectiveUser().getEmail();
    if (pembuka && pemilik && pembuka !== pemilik) return;   // hanya untuk yang menyalakan
    bukaPanel();
  } catch (err) { /* jangan ganggu pembukaan file */ }
}

function namaRentang_(nama) {
  var r = SpreadsheetApp.getActive().getRangeByName(nama);
  return r ? r.getDisplayValue() : '';
}

function cekPanel_(kunci) {
  var c = CacheService.getScriptCache();
  if (!kunci || !c.get('SR_PANEL_' + kunci)) throw new Error('Panel sudah terlalu lama terbuka. Tutup, lalu buka lagi.');
  c.put('SR_PANEL_' + kunci, '1', 21600);
}

function dataPanel(kunci) { cekPanel_(kunci); return dataPanel_(); }
function pratinjau(kunci, no, jenis) { cekPanel_(kunci); return pratinjau_(no, jenis); }
function progresCetak(kunci, id) { cekPanel_(kunci); return progres_(id); }
function cetakPanel(kunci, o) { cekPanel_(kunci); return cetakPanel_(o); }

function dataPanel_() {
  var ss = SpreadsheetApp.getActive();
  var sw = ss.getSheetByName(SR.SISWA).getRange(SR.SISWA1, 1, SR.MAKS, 5).getDisplayValues();
  var siswa = [];
  sw.forEach(function (r, i) {
    if (r[3]) siswa.push({ no: i + 1, nis: r[1], nisn: r[2], nama: r[3], arab: r[4], kurang: [] });
  });
  // nilai: hanya mapel yang sudah mulai diisi guru yang dihitung
  function bacaMapel(tabs, kolom, wadah) {
    tabs.forEach(function (tab) {
      var sh = ss.getSheetByName(tab);
      if (!sh) return;
      var v = sh.getRange(kolom + SR.BARIS_MAPEL + ':' + kolom + (SR.BARIS_MAPEL + SR.MAKS - 1)).getValues();
      var dipakai = v.some(function (r) { return typeof r[0] === 'number'; });
      if (!dipakai) return;
      siswa.forEach(function (s) {
        var x = v[s.no - 1][0];
        if (typeof x === 'number') { s[wadah] = (s[wadah] || []).concat(x); }
        else s.kurang.push(tab);
      });
    });
  }
  bacaMapel(SR.MAPEL_SEKOLAH, 'Q', '_s');
  bacaMapel(SR.MAPEL_PONDOK, 'K', '_p');
  var eks = ss.getSheetByName(SR.EKSKUL);
  var absen = eks ? eks.getRange(SR.EKS1, 12, SR.MAKS, 3).getValues() : [];
  siswa.forEach(function (s) {
    var rata = function (a) { return a && a.length ? a.reduce(function (x, y) { return x + y; }, 0) / a.length : ''; };
    s.rata = rata(s._s); s.pondok = rata(s._p);
    var a = absen[s.no - 1] || ['', '', ''];
    s.sakit = a[0] || 0; s.izin = a[1] || 0; s.alpa = a[2] || 0;
    delete s._s; delete s._p;
  });
  var dinilai = siswa.filter(function (s) { return s.rata !== ''; });
  var dinilaiP = siswa.filter(function (s) { return s.pondok !== ''; });
  siswa.forEach(function (s) {
    s.peringkat = s.rata === '' ? '' : 1 + dinilai.filter(function (t) { return t.rata > s.rata + 1e-9; }).length;
    // peringkat pondok: rata-rata pondok dibulatkan (sama dengan CATATAN PONDOK)
    s.peringkatPondok = s.pondok === '' ? '' : 1 + dinilaiP.filter(function (t) { return Math.round(t.pondok) > Math.round(s.pondok); }).length;
  });
  var pilihan = pilihanSekarang_();
  var dipilih = pilihan ? parseInt(pilihan, 10) : null;
  var tingkat = namaRentang_('SR_TINGKAT'), semester = namaRentang_('SR_SEMESTER');
  return {
    sekolah: namaRentang_('SR_SEKOLAH'), kelas: namaRentang_('SR_KELAS'), semester: semester,
    tahun: namaRentang_('SR_TAHUN'), siswa: siswa, jumlahDinilai: dinilai.length, jumlahPondok: dinilaiP.length,
    dipilih: siswa.some(function (s) { return s.no === dipilih; }) ? dipilih : null,
    saranCover: /^VII \(/.test(tingkat) && semester === 'Ganjil'
  };
}

function teksSiswa_(no) {
  var cocok = daftarSiswa_().filter(function (t) { return parseInt(t, 10) === no; });
  if (!cocok.length) throw new Error('Siswa nomor ' + no + ' tidak ditemukan di tab SISWA.');
  return cocok[0];
}

// gambar raport untuk panel: PDF satu halaman cetak, dikirim sebagai base64
function pratinjau_(no, jenis) {
  var teks = teksSiswa_(parseInt(no, 10));
  if (teks !== pilihanSekarang_()) pilih_(teks);
  var sh = SpreadsheetApp.getActive().getSheetByName(JENIS[jenis]);
  if (!sh) throw new Error('Halaman ' + JENIS[jenis] + ' tidak ada di file ini.');
  SpreadsheetApp.flush();
  return rentangCetak_(sh).map(function (rg) {
    return Utilities.base64Encode(ambilPdf_(urlEkspor_(sh.getSheetId(), rg)).getBytes());
  });
}

function lapor_(id, teks, persen, akhir) {
  if (!id) return;
  var isi = { id: id, teks: teks, persen: persen };
  if (akhir) for (var k in akhir) isi[k] = akhir[k];
  CacheService.getScriptCache().put('SR_PROGRES_' + id, JSON.stringify(isi), 1800);
}

function progres_(id) {
  var v = id ? CacheService.getScriptCache().get('SR_PROGRES_' + id) : null;
  return v ? JSON.parse(v) : null;
}

// Dipanggil panel. Proses cetak berjalan bertahap; panel menanyakan kemajuannya lewat progresCetak().
function cetakPanel_(o) {
  var halaman = URUT_JENIS.filter(function (j) { return o.jenis.indexOf(j) >= 0; })
    .map(function (j) { return JENIS[j]; })
    .filter(function (n) { return SpreadsheetApp.getActive().getSheetByName(n); });
  lapor_(o.id, 'Memulai ...', 0);
  var daftar;
  try {
    if (!halaman.length) throw new Error('Halaman yang dipilih tidak ada di file ini.');
    daftar = o.sekelas ? daftarSiswa_() : [teksSiswa_(parseInt(o.no, 10))];
    if (!daftar.length) throw new Error('Data siswa masih kosong. Isi dulu tab SISWA.');
  } catch (e) {
    lapor_(o.id, '', 100, { selesai: true, galat: e.message });
    return true;
  }
  prosesCetak_({ id: o.id, halaman: halaman, siswa: daftar, sekelas: o.sekelas })
    .then(function (h) { lapor_(o.id, '', 100, { selesai: true, url: h.url, pesan: h.pesan }); })
    .catch(function (e) { lapor_(o.id, '', 100, { selesai: true, galat: e.message }); });
  return true;
}

// ------------------------------------------------------------------ tombol di BERANDA
function pasangTombol() {
  if (!ui_()) return;
  var sh = SpreadsheetApp.getActive().getSheetByName(SR.BERANDA);
  sh.getImages().forEach(function (img) {
    if ((img.getAltTextTitle() || '').indexOf('SR_') === 0) img.remove();
  });
  Object.keys(TOMBOL).forEach(function (k) {
    var t = TOMBOL[k];
    var sel = sh.getRange(t.sel);
    var blob = Utilities.newBlob(Utilities.base64Decode(t.gambar), 'image/png', k + '.png');
    var img = sh.insertImage(blob, sel.getColumn(), sel.getRow(), 4, 2);
    img.setWidth(t.w).setHeight(t.h);
    img.setAltTextTitle('SR_' + k);
    img.assignScript(t.fungsi);
  });
  sh.activate();
  pesan_('Tombol sudah terpasang di BERANDA.\n\nKlik tombolnya untuk pindah siswa atau mencetak PDF.');
}

// ------------------------------------------------------------------ bantu
function toast_(teks) { try { SpreadsheetApp.getActive().toast(teks, 'SmartRapor', 4); } catch (e) { /* aplikasi web */ } }

// jendela Google Sheet tersedia? (tidak tersedia saat dipanggil dari aplikasi web)
function ui_() { try { return SpreadsheetApp.getUi(); } catch (e) { return null; } }

function pesan_(teks) { SpreadsheetApp.getUi().alert('SmartRapor', teks, SpreadsheetApp.getUi().ButtonSet.OK); }

function tampilkanLink_(teks, url, label) {
  var html = HtmlService.createHtmlOutput(
    '<div style="font-family:Poppins,Arial,sans-serif;padding:6px 4px;color:#212529">' +
    '<p style="margin:0 0 14px;font-size:14px">' + teks + '</p>' +
    '<a href="' + url + '" target="_blank" style="display:inline-block;background:#0F5132;color:#fff;' +
    'padding:10px 18px;border-radius:10px;text-decoration:none;font-weight:600">' + label + '</a>' +
    '<p style="margin:14px 0 0;font-size:11px;color:#6c757d">Di halaman PDF, tekan tombol cetak (ikon printer).</p>' +
    '</div>').setWidth(380).setHeight(170);
  SpreadsheetApp.getUi().showModalDialog(html, 'SmartRapor');
}

// ==================================================================================== APLIKASI WEB
