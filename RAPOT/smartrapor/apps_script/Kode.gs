rata-rata ' + angka(m.rata, 1) : '') + '</small></div>' +\n          '<div class=\"pb\"><div class=\"bar\"><i style=\"width:' + p + '%\"></i></div><small>' + m.lengkap + '/' + m.siswa + ' lengkap</small></div>' + st +\n          '<span class=\"aksi\"><button class=\"tb tbg tbk\" onclick=\"buka(\\'nilai\\',\\'' + aman(m.tab) + '\\')\">Isi</button></span></div>';\n      }).join('') + '</div>';\n    });\n    $('isi').innerHTML = judul('Beranda', 'Assalamu\\'alaikum, ' + aman(SAYA.nama), SAYA.peran === 'wali' ? 'Ringkasan kelas hari ini.' : 'Mapel yang Ustadz/Ibu pegang.') + h;\n  }).catch(galatHal);\n}\n\n// =================================================================== nilai\nvar NL = null;   // data mapel yang sedang dibuka\nfunction halNilai(tab) {\n  var mapel = SAYA.mapel;\n  if (!mapel.length) { $('isi').innerHTML = judul('Input nilai', 'Input Nilai') + '<div class=\"blok\"><div class=\"kosong\">Belum ada mapel untuk akun ini. Minta wali kelas mengatur mapel di halaman Akun Guru.</div></div>'; return; }\n  tab = tab || ingatan('sr_mapel_' + SAYA.id);\n  if (mapel.indexOf(tab) < 0) tab = mapel[0];\n  ingat('sr_mapel_' + SAYA.id, tab);\n  HAL.arg = tab;\n  var pilih = '<div class=\"pil\" style=\"margin-bottom:14px\">' + mapel.map(function (t) {\n    return '<button class=\"pl' + (t === tab ? ' on' : '') + '\" onclick=\"buka(\\'nilai\\',\\'' + aman(t) + '\\')\">' + aman(t) + '</button>';\n  }).join('') + '</div>';\n  if (SAYA.link) pilih = '<div class=\"sjd\">Assalamu\\'alaikum, <b>' + aman(SAYA.nama) + '</b>. Silakan isi nilai, lalu tekan tombol <b>💾 Simpan</b> di bawah.</div>';\n  $('isi').innerHTML = judul('Input nilai', 'Input Nilai') + pilih + '<div id=\"nilaiIsi\">' + memuat('Membuka ' + tab + '…') + '</div>';\n  api('webMapel', tab).then(function (d) { NL = d; gambarNilai(); }).catch(function (e) { $('nilaiIsi').innerHTML = '<div class=\"kosong\" style=\"color:#c0392b\">' + aman(e.message) + '</div>'; });\n}\n\nfunction kolomNilai(d) {\n  if (d.jenis === 'umum') {\n    var k = [];\n    for (var i = 0; i < 8; i++) k.push({ k: i, t: 'S' + (i + 1), sub: d.tp[i] || '', redup: !d.tp[i] });\n    return k.concat([{ k: 8, t: 'Non Tes', sub: 'akhir sem.' }, { k: 9, t: 'Tes', sub: 'akhir sem.' }]);\n  }\n  return ['Tugas 1', 'Tugas 2', 'Tugas 3', 'Tugas 4', 'Lisan 1', 'Lisan 2', 'Lisan 3', 'Semester'].map(function (t, i) { return { k: i, t: t, sub: '' }; });\n}\nfunction wajibNilai(d, k) { return d.jenis === 'umum' ? (k === 0 || k === 9) : (k === 0 || k === 7); }\n\nfunction gambarNilai() {\n  var d = NL, kol = kolomNilai(d), umum = d.jenis === 'umum';\n  var h = '<div class=\"kepala\"><div style=\"flex:2;min-width:240px\"><div class=\"jd\" style=\"font-size:24px\">' + aman(d.nama) +\n    '<span class=\"tag\">' + (umum ? 'Mapel sekolah' : 'Mapel pondok') + '</span></div><div class=\"sjd\" style=\"margin:0\">KKTP (nilai tuntas): <b>' + d.kktp + '</b> · ' + d.baris.length + ' siswa</div></div>' +\n    '<div class=\"fl\"><label>Nama guru</label><input class=\"in\" id=\"nGuru\" value=\"' + aman(d.guru) + '\" oninput=\"ubahNilai()\"></div></div>';\n  if (umum) {\n    h += '<details class=\"tp\"' + (d.tp.some(Boolean) ? '' : ' open') + '><summary>📘 Materi / Tujuan Pembelajaran (TP) — ' + d.tp.filter(Boolean).length + ' dari 8 diisi</summary><div class=\"tpg\">' +\n      d.tp.map(function (t, i) { return '<div><label>TP / Sumatif ' + (i + 1) + '</label><textarea data-tp=\"' + i + '\" oninput=\"ubahNilai()\">' + aman(t) + '</textarea></div>'; }).join('') +\n      '</div></details>';\n  }\n  if (!d.baris.length) { $('nilaiIsi').innerHTML = h + '<div class=\"blok\"><div class=\"kosong\">Data siswa masih kosong.</div></div>'; return; }\n  h += '<div class=\"bungkus\"><table class=\"tn\"><thead><tr><th class=\"nm\">Nama siswa</th>' + kol.map(function (c) {\n    return '<th class=\"' + (c.redup ? 'redup' : '') + '\" title=\"' + aman(c.sub) + '\">' + c.t + (c.sub ? '<small>' + aman(c.sub) + '</small>' : '') + '</th>';\n  }).join('') + (umum ? '<th>Rata S</th><th>Rata Akhir</th><th>RAPOR</th>' : '<th>Teori</th><th>Praktik</th>') + '<th>Status</th></tr></thead><tbody>' +\n    d.baris.map(function (b) {\n      return '<tr data-no=\"' + b.no + '\"><td class=\"nm\"><i>' + b.no + '</i>' + aman(b.nama) + '</td>' + kol.map(function (c) {\n        var v = b.isi[c.k];\n        return '<td><input inputmode=\"decimal\" data-no=\"' + b.no + '\" data-k=\"' + c.k + '\" data-awal=\"' + aman(v) + '\" value=\"' + aman(v) + '\"></td>';\n      }).join('') + (umum ? '<td class=\"hs\" data-h=\"rs\"></td><td class=\"hs\" data-h=\"ra\"></td><td class=\"hs rp\" data-h=\"rapor\"></td>' : '<td class=\"hs rp\" data-h=\"teori\"></td><td class=\"hs rp\" data-h=\"praktik\"></td>') +\n        '<td data-h=\"status\"></td></tr>';\n    }).join('') + '</tbody></table></div>' +\n    '<div class=\"ket\"><span><i style=\"background:#fffbea\"></i>diisi guru</span><span><i style=\"background:var(--oranye)\"></i>di bawah KKTP</span><span><i style=\"background:#fff1f1;border-color:#f0a3a3\"></i>wajib, belum diisi</span><span><i style=\"box-shadow:0 0 0 2px var(--e)\"></i>belum disimpan</span><span>Tekan <b>Enter</b> untuk turun ke siswa berikutnya.</span></div>';\n  $('nilaiIsi').innerHTML = h;\n  document.querySelectorAll('#nilaiIsi .tn input').forEach(function (inp) {\n    inp.addEventListener('input', function () { tandaiSel(inp); hitungBaris(inp.closest('tr')); ubahNilai(); });\n    inp.addEventListener('keydown', geserSel);\n    inp.addEventListener('focus', function () { inp.select(); });\n    tandaiSel(inp);\n  });\n  document.querySelectorAll('#nilaiIsi .tn tbody tr').forEach(hitungBaris);\n}\n\nfunction bacaAngka(s) {\n  s = String(s).trim().replace(',', '.');\n  if (s === '') return '';\n  var x = Number(s);\n  return isNaN(x) || x < 0 || x > 100 ? NaN : x;\n}\nfunction tandaiSel(inp) {\n  var x = bacaAngka(inp.value), k = +inp.dataset.k;\n  inp.classList.toggle('galat', x !== '' && isNaN(x));\n  inp.classList.toggle('rendah', x !== '' && !isNaN(x) && x < NL.kktp);\n  inp.classList.toggle('wajib', x === '' && wajibNilai(NL, k));\n  inp.classList.toggle('ubah', inp.value.trim() !== String(inp.dataset.awal));\n}\nfunction rata(a) { a = a.filter(function (x) { return x !== '' && !isNaN(x); }); return a.length ? a.reduce(function (t, x) { return t + x; }, 0) / a.length : ''; }\nfunction bulat(x, d) { if (x === '') return ''; var p = Math.pow(10, d); return Math.round(x * p + 1e-9) / p; }\nfunction hitungBaris(tr) {\n  var v = [];\n  tr.querySelectorAll('input').forEach(function (i) { v[+i.dataset.k] = bacaAngka(i.value); });\n  var sel = function (n) { return tr.querySelector('[data-h=\"' + n + '\"]'); }, ada = function (a) { return a.filter(function (x) { return x !== '' && !isNaN(x); }).length; };\n  var st;\n  if (NL.jenis === 'umum') {\n    var rs = bulat(rata(v.slice(0, 8)), 1), ra = bulat(rata([v[8], v[9]]), 1), rp = bulat(rata([rs, ra]), 0);\n    sel('rs').textContent = angka(rs, 1); sel('ra').textContent = angka(ra, 1);\n    sel('rapor').textContent = rp === '' ? '–' : rp; sel('rapor').classList.toggle('rendah', rp !== '' && rp < NL.kktp);\n    st = ada(v.slice(0, 8)) && ada([v[8], v[9]]) ? 'L' : ada(v) ? 'B' : 'K';\n  } else {\n    var te = bulat(rata(v.slice(0, 4).concat([v[7]])), 0), pr = bulat(rata(v.slice(4, 7).concat([v[7]])), 0);\n    sel('teori').textContent = te === '' ? '–' : te; sel('praktik').textContent = pr === '' ? '–' : pr;\n    sel('teori').classList.toggle('rendah', te !== '' && te < NL.kktp); sel('praktik').classList.toggle('rendah', pr !== '' && pr < NL.kktp);\n    st = ada(v.slice(0, 4)) && v[7] !== '' && !isNaN(v[7]) ? 'L' : ada(v) ? 'B' : 'K';\n  }\n  sel('status').innerHTML = '<span class=\"st ' + st + '\">' + { L: 'Lengkap', B: 'Belum lengkap', K: 'Kosong' }[st] + '</span>';\n}\nfunction geserSel(e) {\n  var inp = e.target, arah = { Enter: 1, ArrowDown: 1, ArrowUp: -1 }[e.key];\n  if (!arah) return;\n  e.preventDefault();\n  var semua = Array.prototype.slice.call(document.querySelectorAll('#nilaiIsi .tn input[data-k=\"' + inp.dataset.k + '\"]'));\n  var j = semua.indexOf(inp) + arah;\n  if (semua[j]) semua[j].focus();\n  else if (arah > 0) { var lanjut = document.querySelector('#nilaiIsi .tn input[data-k=\"' + (+inp.dataset.k + 1) + '\"]'); if (lanjut) lanjut.focus(); }\n}\nfunction ubahNilai() {\n  var ada = document.querySelectorAll('#nilaiIsi .ubah').length ||\n    $('nGuru').value !== NL.guru || Array.prototype.some.call(document.querySelectorAll('[data-tp]'), function (t) { return t.value !== NL.tp[+t.dataset.tp]; });\n  var n = document.querySelectorAll('#nilaiIsi .tn input.ubah').length;\n  setKotor(ada ? simpanNilai : null, n ? n + ' nilai belum disimpan' : 'Ada perubahan belum disimpan');\n}\nfunction simpanNilai() {\n  var salah = document.querySelector('#nilaiIsi .tn input.galat');\n  if (salah) { salah.focus(); return Promise.reject(new Error('ada nilai yang salah (harus 0 sampai 100).')); }\n  var kirim = { ubah: [] };\n  if ($('nGuru').value !== NL.guru) kirim.guru = $('nGuru').value;\n  var tp = Array.prototype.map.call(document.querySelectorAll('[data-tp]'), function (t) { return t.value; });\n  if (NL.jenis === 'umum' && tp.some(function (t, i) { return t !== NL.tp[i]; })) kirim.tp = tp;\n  document.querySelectorAll('#nilaiIsi .tn input.ubah').forEach(function (i) { kirim.ubah.push({ no: +i.dataset.no, k: +i.dataset.k, v: i.value.trim().replace(',', '.') }); });\n  return api('webSimpanMapel', NL.tab, kirim).then(function (d) {\n    var gulir = document.querySelector('.bungkus') ? document.querySelector('.bungkus').scrollLeft : 0;\n    NL = d; setKotor(null); gambarNilai();\n    if (document.querySelector('.bungkus')) document.querySelector('.bungkus').scrollLeft = gulir;\n  });\n}\n\n// =================================================================== kehadiran & catatan\nvar EK = null, EKpilih = null, EKubah = {};\nfunction halHadir(mode) {\n  mode = mode || 'hadir'; HAL.arg = mode;\n  $('isi').innerHTML = judul('Wali kelas', 'Kehadiran & Catatan', 'Ketidakhadiran, ekstrakurikuler, prestasi, catatan wali kelas, dan catatan pondok.') +\n    '<div class=\"pil\" style=\"margin-bottom:14px\"><button class=\"pl' + (mode === 'hadir' ? ' on' : '') + '\" onclick=\"buka(\\'hadir\\',\\'hadir\\')\">📅 Kehadiran sekelas</button>' +\n    '<button class=\"pl' + (mode === 'siswa' ? ' on' : '') + '\" onclick=\"buka(\\'hadir\\',\\'siswa\\')\">📋 Ekskul & catatan per siswa</button></div><div id=\"ekIsi\">' + memuat() + '</div>';\n  EKubah = {};\n  api('webEkskul').then(function (d) { EK = d; mode === 'hadir' ? gambarHadir() : gambarEkSiswa(); })\n    .catch(function (e) { $('ekIsi').innerHTML = '<div class=\"kosong\" style=\"color:#c0392b\">' + aman(e.message) + '</div>'; });\n}\nfunction ubahEk(no, kunci, nilai, idx) {\n  var s = EK.siswa.filter(function (x) { return x.no === no; })[0], u = EKubah[no] = EKubah[no] || { no: no };\n  if (idx != null) { u[kunci] = u[kunci] || s[kunci].slice(); u[kunci][idx] = nilai; } else u[kunci] = nilai;\n  var n = Object.keys(EKubah).length;\n  setKotor(simpanEk, n + ' siswa belum disimpan');\n}\nfunction simpanEk() {\n  var daftar = Object.keys(EKubah).map(function (k) { return EKubah[k]; });\n  return api('webSimpanEkskul', daftar).then(function (d) {\n    EK = d; EKubah = {}; setKotor(null);\n    HAL.arg === 'hadir' ? gambarHadir() : gambarEkSiswa();\n  });\n}\nfunction gambarHadir() {\n  if (!EK.siswa.length) { $('ekIsi').innerHTML = '<div class=\"blok\"><div class=\"kosong\">Data siswa masih kosong.</div></div>'; return; }\n  $('ekIsi').innerHTML = '<div class=\"bungkus\" style=\"max-width:640px\"><table class=\"tn\"><thead><tr><th class=\"nm\">Nama siswa</th><th>Sakit</th><th>Izin</th><th>Tanpa Ket.</th><th>Jumlah</th></tr></thead><tbody>' +\n    EK.siswa.map(function (s) {\n      return '<tr><td class=\"nm\"><i>' + s.no + '</i>' + aman(s.nama) + '</td>' + ['s', 'i', 'a'].map(function (k) {\n        return '<td><input inputmode=\"numeric\" data-no=\"' + s.no + '\" data-k=\"' + k + '\" data-awal=\"' + aman(s[k]) + '\" value=\"' + aman(s[k]) + '\"></td>';\n      }).join('') + '<td class=\"hs\" data-j=\"' + s.no + '\">' + ((+s.s || 0) + (+s.i || 0) + (+s.a || 0)) + '</td></tr>';\n    }).join('') + '</tbody></table></div><div class=\"ket\"><span>Isi jumlah hari. Kosong = 0. Tekan <b>Enter</b> untuk turun.</span></div>';\n  document.querySelectorAll('#ekIsi .tn input').forEach(function (inp) {\n    inp.addEventListener('focus', function () { inp.select(); });\n    inp.addEventListener('keydown', function (e) {\n      var arah = { Enter: 1, ArrowDown: 1, ArrowUp: -1 }[e.key]; if (!arah) return; e.preventDefault();\n      var semua = Array.prototype.slice.call(document.querySelectorAll('#ekIsi .tn input[data-k=\"' + inp.dataset.k + '\"]'));\n      if (semua[semua.indexOf(inp) + arah]) semua[semua.indexOf(inp) + arah].focus();\n    });\n    inp.addEventListener('input', function () {\n      var v = inp.value.trim(), ok = v === '' || /^[0-9]{1,3}$/.test(v);\n      inp.classList.toggle('galat', !ok); inp.classList.toggle('ubah', v !== inp.dataset.awal);\n      var tr = inp.closest('tr'), t = 0; tr.querySelectorAll('input').forEach(function (x) { t += +x.value || 0; });\n      tr.querySelector('[data-j]').textContent = t;\n      ubahEk(+inp.dataset.no, inp.dataset.k, v);\n    });\n  });\n}\n\nfunction daftarSiswaHtml(siswa, pilih, fnKlik, tanda) {\n  return siswa.map(function (s) {\n    return '<button class=\"s' + (s.no === pilih ? ' on' : '') + '\" onclick=\"' + fnKlik + '(' + s.no + ')\"><span class=\"nu\">' + ('0' + s.no).slice(-2) + '</span><span class=\"av\">' + aman(inisial(s.nama || s.isi && s.isi[3])) + '</span><span class=\"nmm\">' + aman(s.nama || (s.isi && s.isi[3]) || '(kosong)') + '</span>' + (tanda && tanda(s) ? '<span class=\"tt\"></span>' : '') + '</button>';\n  }).join('');\n}\nfunction saringDaftar(inp) {\n  var q = inp.value.trim().toUpperCase();\n  inp.parentNode.querySelectorAll('.s').forEach(function (b) { b.hidden = q && b.querySelector('.nmm').textContent.toUpperCase().indexOf(q) < 0; });\n}\nfunction datalist(id, arr) { return '<datalist id=\"' + id + '\">' + arr.map(function (x) { return '<option value=\"' + aman(x) + '\">'; }).join('') + '</datalist>'; }\n\nfunction gambarEkSiswa(no) {\n  if (!EK.siswa.length) { $('ekIsi').innerHTML = '<div class=\"blok\"><div class=\"kosong\">Data siswa masih kosong.</div></div>'; return; }\n  EKpilih = no || EKpilih || EK.siswa[0].no;\n  if (!EK.siswa.some(function (s) { return s.no === EKpilih; })) EKpilih = EK.siswa[0].no;\n  var s0 = EK.siswa.filter(function (x) { return x.no === EKpilih; })[0], u = EKubah[EKpilih] || {};\n  var s = {}; for (var k in s0) s[k] = u[k] != null ? u[k] : s0[k];\n  var P = EK.pilihan, idx = EK.siswa.indexOf(s0);\n  var h = '<div class=\"dua\"><div class=\"daftar\"><input class=\"in cari\" placeholder=\"🔍 Cari nama…\" oninput=\"saringDaftar(this)\"><div class=\"isi\">' +\n    daftarSiswaHtml(EK.siswa, EKpilih, 'gambarEkSiswa', function (x) { return EKubah[x.no]; }) + '</div></div><div class=\"blok\" style=\"margin:0\">' +\n    '<div class=\"hdr\"><div class=\"nmb\">' + aman(s.nama) + '</div><button class=\"tb tbg tbk\" ' + (idx ? '' : 'disabled') + ' onclick=\"gambarEkSiswa(' + (idx ? EK.siswa[idx - 1].no : 0) + ')\">‹ Sebelumnya</button>' +\n    '<button class=\"tb tbg tbk\" ' + (idx < EK.siswa.length - 1 ? '' : 'disabled') + ' onclick=\"gambarEkSiswa(' + (idx < EK.siswa.length - 1 ? EK.siswa[idx + 1].no : 0) + ')\">Berikutnya ›</button></div>' +\n    '<div class=\"f\"><div class=\"gj\">Ketidakhadiran (hari)</div><div class=\"hadir3\">' +\n    [['s', 'Sakit'], ['i', 'Izin'], ['a', 'Tanpa Ket.']].map(function (x) {\n      return '<div class=\"c\"><div class=\"k\">' + x[1] + '</div><div class=\"stp\"><button onclick=\"langkah(\\'' + x[0] + '\\',-1)\">−</button><input class=\"in\" id=\"ek_' + x[0] + '\" inputmode=\"numeric\" value=\"' + aman(s[x[0]]) + '\" oninput=\"ubahEk(' + EKpilih 